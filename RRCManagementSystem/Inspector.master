<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inspector.master.cs" Inherits="RRCManagementSystem.Inspector" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />                   
    <title>Inspector Panel</title>

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        :root { --sidebar-w: 280px; --header-h: 60px; }

        body { background-color: #f3f4f6; }

        header.app-header {
            height: var(--header-h);
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1050;
        }

        #sidebarDesktop {
            position: fixed;
            top: var(--header-h);
            left: 0;
            width: var(--sidebar-w);
            height: calc(100vh - var(--header-h));
            overflow-y: auto;
        }

        @media (min-width: 992px) {
            #mainContent {
                margin-left: var(--sidebar-w);
                margin-top: var(--header-h);
                padding: 30px;
                min-height: calc(100vh - var(--header-h) - 56px);
                background-color: #f3f4f6;
            }
            footer.app-footer {
                left: var(--sidebar-w);
                width: calc(100% - var(--sidebar-w));
            }
        }

        @media (max-width: 991.98px) {
            #mainContent {
                margin: 0;
                margin-top: var(--header-h);
                padding: 16px;
                min-height: calc(100vh - var(--header-h) - 56px);
            }
            footer.app-footer {
                left: 0;
                width: 100%;
            }
        }

        #notificationList {
            right: 0;
            top: 35px;
            width: 300px;
            display: none;
            z-index: 1090;
            max-height: 350px;
            overflow-y: auto;
        }

        .unread { font-weight: bold; background-color: #f8f9fa; }
        .read { font-weight: normal; color: #6c757d; }
    </style>
</head>
<body>
    <form id="form1" runat="server" class="d-flex flex-column min-vh-100">
        <!-- Header -->
        <header class="app-header bg-dark text-white d-flex align-items-center justify-content-between px-3 px-md-4">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light d-lg-none me-1" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile" aria-controls="sidebarMobile">
                    <i class="fas fa-bars"></i>
                </button>
                <h2 class="mb-0 fs-5">Inspector Panel</h2>
            </div>

            <div class="d-flex align-items-center position-relative">
                <asp:Label ID="lblInspectorName" runat="server" CssClass="me-3 me-md-4 fw-bold" />

                <div id="notificationBell" class="position-relative me-2 me-md-3" style="cursor:pointer;" onclick="toggleNotificationList(); markNotificationsAsRead();">
                    <i class="fas fa-bell fs-5"></i>

                    <!-- Badge for unread count -->
                    <span id="notificationCount" runat="server" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 10px;">0</span>

                    <!-- Notification Dropdown -->
                   <div id="notificationList" class="position-absolute bg-white text-dark rounded shadow p-3" 
                         style="margin-top: 15px; right: 0; width: 320px; max-height: 400px; overflow-y: auto; display: none; z-index: 1000; border-radius: 8px;">
                        <h6 class="fw-bold mb-2">Notifications</h6>
                        <div id="notificationItems"></div>
                    </div>

                </div>
            </div>
        </header>

        <!-- Desktop Sidebar -->
        <aside id="sidebarDesktop" class="d-none d-lg-flex flex-column text-white bg-black">
            <ul class="nav flex-column mt-2">
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="InspectorDashboard.aspx">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="MyInspections.aspx">
                        <i class="fas fa-search me-2"></i> Inspections
                    </a>
                </li>
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="CreateBooking.aspx">
                        <i class="fas fa-tasks me-2"></i> Assign Booking
                    </a>
                </li>
            </ul>

            <asp:LinkButton ID="btnLogout" runat="server"
                CssClass="btn btn-danger fw-bold w-75 mx-auto my-4 d-block"
                OnClick="btnLogout_Click">
                <i class="fas fa-sign-out-alt me-2"></i> Logout
            </asp:LinkButton>
        </aside>

        <!-- Mobile Sidebar -->
        <div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="sidebarMobile" aria-labelledby="sidebarMobileLabel" style="width: var(--sidebar-w);">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="sidebarMobileLabel">Menu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column justify-content-between">
                <ul class="nav flex-column">
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="InspectorDashboard.aspx">
                            <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="MyInspections.aspx">
                            <i class="fas fa-search me-2"></i> Inspections
                        </a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="CreateBooking.aspx">
                            <i class="fas fa-tasks me-2"></i> Assign Booking
                        </a>
                    </li>
                </ul>

                <asp:LinkButton ID="btnLogoutMobile" runat="server"
                    CssClass="btn btn-danger fw-bold w-100 mt-3"
                    OnClick="btnLogout_Click">
                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                </asp:LinkButton>
            </div>
        </div>

        <!-- Main Content -->
        <main id="mainContent" class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Footer -->
        <footer class="app-footer bg-dark text-white text-center py-3 position-fixed bottom-0" style="z-index: 1030;">
            &copy; 2025 RRC Management System - Inspector
        </footer>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        async function loadNotifications() {
            try {
                const res = await fetch('GetNotificationInspector.aspx');
                const data = await res.json();
                const badge = document.getElementById('notificationCount');
                const list = document.getElementById('notificationItems');

                badge.textContent = data.unread || 0;
                badge.style.display = (data.unread && data.unread > 0) ? 'inline-block' : 'none';

                if (!data.notifications || data.notifications.length === 0) {
                    list.innerHTML = "<div class='text-center text-muted small p-2'>No notifications.</div>";
                    return;
                }

                list.innerHTML = data.notifications.map(item => `
                    <a href="${item.url || '#'}" class="text-decoration-none text-dark d-block" onclick="event.stopPropagation();">
                        <div class="border-bottom pb-2 mb-2 ${item.isRead ? 'read' : 'unread'}">
                            <div>${item.title}</div>
                            ${item.body ? `<div class="small mt-1 text-muted">${item.body}</div>` : ''}
                            <div class="small text-muted">${item.date}</div>
                        </div>
                    </a>
                `).join('');
            } catch (err) {
                console.error("Failed to load notifications:", err);
            }
        }

        async function markNotificationsAsRead() {
            try {
                await fetch('GetNotificationInspector.aspx?action=markread', { method: 'POST' });
            } catch (err) {
                console.error("Failed to mark notifications as read:", err);
            }
        }

        function toggleNotificationList() {
            var list = document.getElementById("notificationList");
            list.style.display = (list.style.display === "block") ? "none" : "block";
        }

        // Close dropdown when clicking outside
        document.addEventListener("click", function (event) {
            var bell = document.getElementById("notificationBell");
            if (!bell.contains(event.target)) {
                document.getElementById("notificationList").style.display = "none";
            }
        });

        loadNotifications();
        setInterval(loadNotifications, 30000);
    </script>
</body>
</html>
