<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inspector.master.cs" Inherits="RRCManagementSystem.Inspector" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inspector Panel</title>

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        :root { --sidebar-w: 280px; --header-h: 60px; }

        body { background-color: #f3f4f6; }
        /* Fixed header */
        header.app-header {
            height: var(--header-h);
            position: fixed; top: 0; left: 0; width: 100%;
            z-index: 1050;
        }

        /* Desktop sidebar (lg+) */
        #sidebarDesktop {
            position: fixed; top: var(--header-h); left: 0;
            width: var(--sidebar-w); height: calc(100vh - var(--header-h));
            overflow-y: auto;
        }

        /* Main content + footer (desktop) */
        @media (min-width: 992px) {
            #mainContent {
                margin-left: var(--sidebar-w);
                margin-top: var(--header-h);
                padding: 30px;
                min-height: calc(100vh - var(--header-h) - 56px); /* keep space for footer */
                background-color: #f3f4f6;
            }
            footer.app-footer {
                left: var(--sidebar-w);
                width: calc(100% - var(--sidebar-w));
            }
        }

        /* Mobile/tablet (below lg): no left margin; footer full width */
        @media (max-width: 991.98px) {
            #mainContent {
                margin: 0; margin-top: var(--header-h);
                padding: 16px;
                min-height: calc(100vh - var(--header-h) - 56px);
            }
            footer.app-footer {
                left: 0; width: 100%;
            }
        }

        /* Notification list popover */
        #notificationList {
            right: 0; top: 30px; width: 300px; display: none; z-index: 1090;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server" class="d-flex flex-column min-vh-100">

        <!-- Header -->
        <header class="app-header bg-dark text-white d-flex align-items-center justify-content-between px-3 px-md-4">
            <div class="d-flex align-items-center gap-2">
                <!-- Burger: visible only on mobile/tablet -->
                <button class="btn btn-outline-light d-lg-none me-1" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile" aria-controls="sidebarMobile">
                    <i class="fas fa-bars"></i>
                </button>
                <h2 class="mb-0 fs-5">Inspector Panel</h2>
            </div>

            <div class="d-flex align-items-center">
                <asp:Label ID="lblInspectorName" runat="server" CssClass="me-3 me-md-4 fw-bold" />
                <div id="notificationBell" class="position-relative me-2 me-md-3" onclick="toggleNotificationList()" style="cursor:pointer;">
                    <i class="fas fa-bell fs-5"></i>
                    <span id="notificationCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 10px;">0</span>
                    <div id="notificationList" class="position-absolute bg-white text-dark rounded shadow p-3">
                        <div id="notificationItems"></div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Desktop Sidebar (lg and up) -->
        <aside id="sidebarDesktop" class="d-none d-lg-flex flex-column text-white bg-black">
            <ul class="nav flex-column mt-2">
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="InspectorDashboard.aspx">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="MyInspections.aspx">
                        <i class="fas fa-search me-2"></i> Inspections
                    </a>
                </li>
                <li class="nav-item border-bottom">
                    <a class="nav-link text-white px-4 py-3" href="CreateBooking.aspx">
                        <i class="fas fa-tasks me-2"></i> Assign Booking
                    </a>
                </li>
            </ul>

            <asp:LinkButton ID="btnLogout" runat="server"
                CssClass="btn btn-danger fw-bold w-75 mx-auto my-4 d-block"
                OnClick="btnLogout_Click">
                <i class="fas fa-sign-out-alt me-2"></i> Logout
            </asp:LinkButton>
        </aside>

        <!-- Mobile/Tablet Offcanvas Sidebar -->
        <div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="sidebarMobile" aria-labelledby="sidebarMobileLabel" style="width: var(--sidebar-w);">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="sidebarMobileLabel">Menu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column justify-content-between">
                <ul class="nav flex-column">
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="InspectorDashboard.aspx">
                            <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="MyInspections.aspx">
                            <i class="fas fa-search me-2"></i> Inspections
                        </a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-white px-2 py-3" href="CreateBooking.aspx">
                            <i class="fas fa-tasks me-2"></i> Assign Booking
                        </a>
                    </li>
                </ul>

                <asp:LinkButton ID="btnLogoutMobile" runat="server"
                    CssClass="btn btn-danger fw-bold w-100 mt-3"
                    OnClick="btnLogout_Click">
                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                </asp:LinkButton>
            </div>
        </div>

        <!-- Main Content -->
        <main id="mainContent" class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Footer -->
        <footer class="app-footer bg-dark text-white text-center py-3 position-fixed bottom-0" style="z-index: 1030;">
            &copy; 2025 RRC Management System - Inspector
        </footer>
    </form>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function loadNotifications() {
        fetch('GetNotifications.ashx')
            .then(res => res.json())
            .then(data => {
                const unread = data.filter(x => !x.isRead).length;
                const badge = document.getElementById('notificationCount');
                const list = document.getElementById('notificationItems');

                if (unread > 0) {
                    badge.textContent = unread;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }

                if (data.length === 0) {
                    list.innerHTML = "<div class='text-center'>No notifications.</div>";
                    return;
                }

                list.innerHTML = data.map(item => `
        <a href="${item.url || '#'}" class="text-decoration-none text-dark d-block"
           onclick="event.stopPropagation();">
          <div class="border-bottom pb-2 mb-2 ${item.isRead ? '' : 'fw-semibold'}">
            <div>${item.title}</div>
            <small class="text-muted">${item.date}</small>
            ${item.body ? `<div class="small mt-1">${item.body}</div>` : ''}
          </div>
        </a>
      `).join('');
            })
            .catch(() => { });
    }

    function markNotificationsAsRead() {
        fetch('MarkAsRead.ashx', { method: 'POST' })
            .then(() => {
                document.getElementById('notificationCount').style.display = 'none';
                loadNotifications();
            })
            .catch(() => { });
    }

    function toggleNotificationList() {
        const list = document.getElementById('notificationList');
        list.style.display = (list.style.display === 'block') ? 'none' : 'block';
        if (list.style.display === 'block') markNotificationsAsRead();
    }

    // click-away close
    document.addEventListener('click', function (e) {
        if (!e.target.closest('#notificationBell')) {
            document.getElementById('notificationList').style.display = 'none';
        }
    });

    // initial + periodic refresh
    loadNotifications();
    setInterval(loadNotifications, 30000);
</script>

</body>
</html>
