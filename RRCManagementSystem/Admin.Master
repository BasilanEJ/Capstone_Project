    <%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="RRCManagementSystem.Admin" %>

    <!DOCTYPE html>
    <html lang="en">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />
        <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /> | RRC Termite & Pest Control</title>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

        <style>
            body { margin: 0; font-family: 'Arial', sans-serif; background-color: #f4f4f4; }
            .header {
                display: flex; align-items: center; justify-content: space-between;
                background-color: #004085; color: white; padding: 15px 20px;
                position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
                box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            }
            .logo-container { display: flex; align-items: center; }
            .logo {
    height: 50px;
    margin-right: 15px;
    filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 6px #fff);
    border-radius: 4px; /* optional, makes it softer */
}

            .header h1 { margin: 0; font-size: 20px; }
            .sidebar {
                position: fixed; top: 70px; left: 0; width: 260px; height: calc(100% - 70px);
                background-color: #1f2937; color: white; overflow-y: auto;
                transition: left 0.3s ease; padding-top: 20px;
            }
            .sidebar_menu { list-style: none; margin: 0; padding: 0; }
            .sidebar_menu li { border-bottom: 1px solid #374151; }
            .sidebar_menu li a {
                display: flex; align-items: center; padding: 12px 20px;
                color: white; text-decoration: none; transition: background-color 0.3s;
            }
            .sidebar_menu li a:hover { background-color: #4b5563; }
            .sidebar_menu li a i { margin-right: 10px; }
            .logout-button {
                display: block; text-align: left; padding: 12px 20px;
                color: white; background-color: #dc3545; border: none;
                width: 100%; cursor: pointer; transition: background-color 0.3s;
            }
            .logout-button:hover { background-color: #c82333; }
            .content { margin-left: 260px; margin-top: 70px; padding: 30px; transition: margin-left 0.3s ease; }
            .burger-menu {
                display: none; position: fixed; top: 15px; left: 20px; font-size: 24px;
                color: white; background: none; border: none; cursor: pointer; z-index: 1001;
            }
            .chat-client-button {
                color: #fff; padding: 8px 15px; border-radius: 4px;
                text-decoration: none; font-weight: bold; display: flex;
                align-items: center; gap: 8px;
            }
            .chat-client-button:hover { background-color: #e0a800; color: #fff; }
            .chat-client-button i { font-size: 25px; }
            .admin-info { color: #fff; display: flex; align-items: center; font-weight: 600; font-size: 14px; }
            .admin-info i { margin-right: 6px; font-size: 18px; }
            .admin-name-label { color: #fff; }

            @media (max-width: 992px) {
                .sidebar { left: -260px; }
                .sidebar.open { left: 0; }
                .burger-menu { display: block; }
                .content { margin-left: 0; }
            }

            .sidebar_menu li a.active {
    background-color: #2563eb; /* or any highlight color */
    font-weight: bold;
}

        </style>

        <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    </head>

    <body>
        <form id="form1" runat="server">
            <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="false" />
            <!-- Header -->
            <header class="header">
                <div class="logo-container">
                    <img src="\images\logorrc.png" class="logo" alt="RRC Logo" />

                </div>

               <div style="display: flex; align-items: center; gap: 10px;">
                <!--<a href="../ChatWithClient.aspx" class="chat-client-button" title="Chat with Clients"
                   onclick="window.location.href=this.href; return false;">
                    <i class="fab fa-facebook-messenger"></i>
                </a>  -->

                    <div class="admin-info">
                        <i class="fas fa-user-circle"></i>
                        <asp:Label ID="lblAdminName" runat="server" CssClass="admin-name-label" />
                    </div>
                    <button id="burgerMenu" class="burger-menu"><i class="fas fa-bars"></i></button>
                </div>
            </header>

<!-- Sidebar -->
<!-- Sidebar -->
<nav class="sidebar">
    <ul class="sidebar_menu">
        <%
            List<string> allowed = Session["AllowedModules"] as List<string>;
            if (allowed != null)
            {
        %>
            <% if (allowed.Contains("Dashboard")) { %>
                <li>
                    <a class='<%= GetActiveClass("Dashboard.aspx") %>' href='<%= ResolveUrl("~/Dashboard.aspx") %>'>
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageBooking")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageBooking.aspx") %>' href='<%= ResolveUrl("~/ManageBooking.aspx") %>'>
                        <i class="fas fa-book"></i> Bookings
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageClient")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageClient.aspx") %>' href='<%= ResolveUrl("~/ManageClient.aspx") %>'>
                        <i class="fas fa-users"></i> Clients
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("Sales&Transaction")) { %>
                <li>
                    <a class='<%= GetActiveClass("SalesAndTransactions.aspx") %>' href='<%= ResolveUrl("~/SalesAndTransactions.aspx") %>'>
                        <i class="fas fa-receipt"></i> Sales & Transactions
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageEmployees")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageEmployee.aspx") %>' href='<%= ResolveUrl("~/ManageEmployee.aspx") %>'>
                        <i class="fas fa-user-tie"></i> Manage Employees
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageItem")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageItem.aspx") %>' href='<%= ResolveUrl("~/ManageItem.aspx") %>'>
                        <i class="fas fa-boxes"></i> Manage Items
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageEquipment")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageEquipment.aspx") %>' href='<%= ResolveUrl("~/ManageEquipment.aspx") %>'>
                        <i class="fas fa-tools"></i> Manage Equipment
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageServices")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageServices.aspx") %>' href='<%= ResolveUrl("~/ManageServices.aspx") %>'>
                        <i class="fas fa-bug"></i> Manage Services
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageSupplier")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageSupplier.aspx") %>' href='<%= ResolveUrl("~/ManageSupplier.aspx") %>'>
                        <i class="fas fa-box"></i> Manage Supplier
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("AdminReports")) { %>
                <li>
                    <a class='<%= GetActiveClass("AdminReports.aspx") %>' href='<%= ResolveUrl("~/AdminReports.aspx") %>'>
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("ManageInquiry")) { %>
                <li>
                    <a class='<%= GetActiveClass("ManageInquiry.aspx") %>' href='<%= ResolveUrl("~/ManageInquiry.aspx") %>'>
                        <i class="fas fa-file-alt"></i> Manage Inquiry
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("CreateCustomerAccount")) { %>
                <li>
                    <a class='<%= GetActiveClass("CreateCustomerAccount.aspx") %>' href='<%= ResolveUrl("~/CreateCustomerAccount.aspx") %>'>
                        <i class="fas fa-user-plus"></i> Create Customer Account
                    </a>
                </li>
            <% } %>

            <% if (allowed.Contains("AdminGuide")) { %>
                <li>
                    <a class='<%= GetActiveClass("AdminGuide.aspx") %>' href='<%= ResolveUrl("~/AdminGuide.aspx") %>'>
                        <i class="fas fa-book-open"></i> Admin Guide
                    </a>
                </li>
            <% } %>
        <%
            }
            else
            {
        %>
            <li style="color:red; padding:12px;">⚠ Session permissions not loaded</li>
        <%
            }
        %>

        <!-- Always visible Logout -->
        <li>
            <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="logout-button">
                <i class="fas fa-sign-out-alt"></i> Logout
            </asp:LinkButton>
        </li>
    </ul>
</nav>




            <!-- Main Content -->
            <main class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </form>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                let burgerMenu = document.getElementById("burgerMenu");
                let sidebar = document.querySelector(".sidebar");

                burgerMenu.addEventListener("click", function () {
                    sidebar.classList.toggle("open");
                });
            });
        </script>
    </body>
    </html>
