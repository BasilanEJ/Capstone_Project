<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="RRCManagementSystem.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /> | RRC Termite & Pest Control</title>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <!-- Internal CSS -->
    <style>
        body {
            margin: 0;
            font-family: 'Arial', sans-serif;
            background-color: #f4f4f4;
        }

        /* Header */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #004085;
            color: white;
            padding: 15px 20px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .logo-container {
            display: flex;
            align-items: center;
        }

        .logo {
            height: 40px;
            margin-right: 15px;
        }

        .header h1 {
            margin: 0;
            font-size: 20px;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 70px;
            left: 0;
            width: 260px;
            height: calc(100% - 70px);
            background-color: #1f2937;
            color: white;
            overflow-y: auto;
            transition: left 0.3s ease;
            padding-top: 20px;
        }

        .sidebar.open {
            left: 0;
        }

        .sidebar_menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar_menu li {
            border-bottom: 1px solid #374151;
        }

        .sidebar_menu li a {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s;
        }

        .sidebar_menu li a:hover {
            background-color: #4b5563;
        }

        .sidebar_menu li a i {
            margin-right: 10px;
        }

        .accordion {
            display: none;
            background-color: #374151;
        }

        .accordion li a {
            padding-left: 40px;
            font-size: 14px;
        }

        .sidebar_menu li .arrow {
            margin-left: auto;
            transition: transform 0.3s;
        }

        .sidebar_menu li.active .arrow {
            transform: rotate(180deg);
        }

        /* Burger Menu */
        .burger-menu {
            display: none;
            position: fixed;
            top: 15px;
            left: 20px;
            font-size: 24px;
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 1001;
        }

        /* Logout Button */
        .logout-button {
            display: block;
            text-align: left;
            padding: 12px 20px;
            color: white;
            background-color: #dc3545;
            border: none;
            width: 100%;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .logout-button:hover {
            background-color: #c82333;
        }

        /* Main content */
        .content {
            margin-left: 260px;
            margin-top: 70px;
            padding: 30px;
            transition: margin-left 0.3s ease;
        }

   .chat-client-button {
    color: #fff;
    padding: 8px 15px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease;
    display: flex; /* So icon and text are aligned */
    align-items: center;
    gap: 8px; /* Optional: adds space between icon and text */
}

.chat-client-button:hover {
    background-color: #e0a800;
    color: #fff;
}

.chat-client-button i {
    font-size: 25px;  /* <== Increase icon size here */
}


.admin-info {
    color: #fff;
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 14px;
}

.admin-info i {
    margin-right: 6px;
    font-size: 18px;
}

.admin-name-label {
    color: #fff;
}



        /* Responsive */
        @media (max-width: 992px) {
            .sidebar {
                left: -260px;
            }

            .sidebar.open {
                left: 0;
            }

            .burger-menu {
                display: block;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">

        <!-- Header -->
       <!-- Header -->
<!-- Header -->
<header class="header">
    <div class="logo-container">
        <img src="\images\logorrc.png" class="logo" alt="RRC Logo" />
        <h1>Admin Dashboard</h1>
    </div>

    <!-- Chat Button + Admin Name -->
    <div style="display: flex; align-items: center; gap: 10px;">
        <!-- Chat Button -->
        <a href="../ChatWithClient.aspx" class="chat-client-button" title="Chat with Clients">
            <i class="fab fa-facebook-messenger"></i>
        </a>

        <!-- Admin Name / Email Label -->
        <div class="admin-info">
            <i class="fas fa-user-circle"></i>
            <asp:Label ID="lblAdminName" runat="server" Text="" CssClass="admin-name-label" />
        </div>

        <!-- Burger Menu -->
        <button id="burgerMenu" class="burger-menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</header>



        <!-- Sidebar -->
<nav class="sidebar">
    <ul class="sidebar_menu">
        <% var allowed = ViewState["AllowedModules"] as List<string>; %>

        <% if (allowed != null && allowed.Contains("Dashboard")) { %>
        <li><a href='<%= ResolveUrl("Dashboard.aspx") %>'><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageInquiry")) { %>
        <li><a href="ManageInquiry.aspx"><i class="fas fa-file-alt"></i> Manage Inquiry</a></li>
        <% } %>

    <!--    <% if (allowed != null && allowed.Contains("ClientApproval")) { %>
        <li><a href="../ClientApproval.aspx"><i class="fas fa-user-check"></i> Client Approval</a></li>
        <% } %>  -->

        <% if (allowed != null && allowed.Contains("CreateCustomerAccount")) { %>
<li><a href="CreateCustomerAccount.aspx"><i class="fas fa-user-plus"></i> Create Customer Account</a></li>
<% } %>


        <% if (allowed != null && allowed.Contains("ManageEmployees")) { %>
        <li><a href="ManageEmployee.aspx"><i class="fas fa-user-tie"></i> Manage Employees</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageItem")) { %>
        <li><a href="ManageItem.aspx"><i class="fas fa-boxes"></i> Manage Items</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageEquipment")) { %>
        <li><a href="ManageEquipment.aspx"><i class="fas fa-tools"></i> Manage Equipment</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageClient")) { %>
        <li><a href="ManageClient.aspx"><i class="fas fa-users"></i> Clients</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageBooking")) { %>
        <li><a href="ManageBooking.aspx"><i class="fas fa-book"></i> Bookings</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("Sales&Transaction")) { %>
        <li><a href="SalesAndTransactions.aspx"><i class="fas fa-receipt"></i> Sales & Transactions</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageSupplier")) { %>
        <li><a href="ManageSupplier.aspx"><i class="fas fa-box"></i> Manage Supplier</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("ManageServices")) { %>
        <li><a href="ManageServices.aspx"><i class="fas fa-bug"></i> Manage Services</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("AdminReports")) { %>
        <li><a href="AdminReports.aspx"><i class="fas fa-chart-bar"></i> Reports</a></li>
        <% } %>

        <% if (allowed != null && allowed.Contains("AdminGuide")) { %>
        <li><a href="AdminGuide.aspx"><i class="fas fa-book-open"></i> Admin Guide</a></li>
        <% } %>


        <li>
            <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="logout-button">
                <i class="fas fa-sign-out-alt"></i> Logout
            </asp:LinkButton>
        </li>
    </ul>
</nav>


        <!-- Main Content -->
        <main class="content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

    </form>

    <!-- JavaScript (for menu toggle and sidebar behavior) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let menuItems = document.querySelectorAll(".sidebar_menu > li > a");

            menuItems.forEach(item => {
                item.addEventListener("click", function (e) {
                    let submenu = this.nextElementSibling;

                    if (submenu && submenu.classList.contains("accordion")) {
                        e.preventDefault();

                        document.querySelectorAll(".accordion").forEach(acc => {
                            if (acc !== submenu) {
                                acc.style.display = "none";
                                acc.parentElement.classList.remove("active");
                            }
                        });

                        submenu.style.display = submenu.style.display === "block" ? "none" : "block";
                        this.parentElement.classList.toggle("active");
                    }
                });
            });

            let burgerMenu = document.getElementById("burgerMenu");
            let sidebar = document.querySelector(".sidebar");

            burgerMenu.addEventListener("click", function () {
                sidebar.classList.toggle("open");
            });
        });
    </script>

</body>
</html>