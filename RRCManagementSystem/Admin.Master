<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="RRCManagementSystem.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />
    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /> | RRC Termite & Pest Control</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <style>
        :root {
            --sidebar-width: 260px;
        }

        #content {
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s ease-in-out;
        }

        #sidebar {
            width: var(--sidebar-width);
            transition: transform 0.3s ease-in-out;
            transform: translateX(0);
        }

        @media (max-width: 1023px) {
            #content {
                margin-left: 0;
            }
            #sidebar {
                transform: translateX(-100%);
            }
            #sidebar.open {
                transform: translateX(0);
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body class="bg-gray-100 font-sans leading-normal tracking-normal">
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="false" />

        <header class="bg-blue-800 text-white shadow-md fixed w-full top-0 left-0 z-50 px-4 py-3 flex items-center justify-between lg:justify-start">
            <button id="burgerMenu" class="block lg:hidden text-2xl text-white mr-4 focus:outline-none">
                <i class="fas fa-bars"></i>
            </button>
            <div class="flex items-center flex-grow">
                <img src="\images\logorrc.png" class="h-10 w-10 mr-4 rounded-lg shadow-sm" alt="RRC Logo" />
                <h1 class="text-xl font-bold hidden md:block">Admin Dashboard</h1>
            </div>

            <div class="flex items-center space-x-4">
                <div class="flex items-center text-sm font-semibold">
                    <i class="fas fa-user-circle text-lg mr-2"></i>
                    <asp:Label ID="lblAdminName" runat="server" CssClass="text-white" />
                </div>
            </div>
        </header>

        <div class="flex">
            <nav id="sidebar" class="bg-gray-800 text-gray-300 fixed h-full top-16 z-40 overflow-y-auto">
                <ul class="flex flex-col py-4">
                    <%
                        List<string> allowed = Session["AllowedModules"] as List<string>;
                        string currentPath = Request.Url.AbsolutePath.ToLower();
                        if (allowed != null)
                        {
                    %>
                        <% if (allowed.Contains("Dashboard")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("dashboard.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/Dashboard.aspx") %>'>
                                    <i class="fas fa-tachometer-alt mr-3"></i> Dashboard
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("ManageBooking")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("managebooking.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageBooking.aspx") %>'>
                                    <i class="fas fa-book mr-3"></i> Bookings
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("ManageClient")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageclient.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageClient.aspx") %>'>
                                    <i class="fas fa-users mr-3"></i> Clients
                                </a>
                            </li>
                        <% } %>
                        
                        <% if (allowed.Contains("Sales&Transaction")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("salesandtransactions.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/SalesAndTransactions.aspx") %>'>
                                    <i class="fas fa-receipt mr-3"></i> Sales & Transactions
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("ManageEmployees")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageemployee.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageEmployee.aspx") %>'>
                                    <i class="fas fa-user-tie mr-3"></i> Manage Employees
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("ManageItem")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageitem.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageItem.aspx") %>'>
                                    <i class="fas fa-boxes mr-3"></i> Manage Items
                                </a>
                            </li>
                        <% } %>
                        
                        <% if (allowed.Contains("ManageEquipment")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageequipment.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageEquipment.aspx") %>'>
                                    <i class="fas fa-tools mr-3"></i> Manage Equipment
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("ManageServices")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageservices.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageServices.aspx") %>'>
                                    <i class="fas fa-bug mr-3"></i> Manage Services
                                </a>
                            </li>
                        <% } %>
                        
                        <% if (allowed.Contains("ManageSupplier")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("managesupplier.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageSupplier.aspx") %>'>
                                    <i class="fas fa-box mr-3"></i> Manage Supplier
                                </a>
                            </li>
                        <% } %>
                        
                        <% if (allowed.Contains("AdminReports")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("adminreports.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/AdminReports.aspx") %>'>
                                    <i class="fas fa-chart-bar mr-3"></i> Reports
                                </a>
                            </li>
                        <% } %>
                        
                        <% if (allowed.Contains("ManageInquiry")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("manageinquiry.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/ManageInquiry.aspx") %>'>
                                    <i class="fas fa-file-alt mr-3"></i> Manage Inquiry
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("CreateCustomerAccount")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("createcustomeraccount.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/CreateCustomerAccount.aspx") %>'>
                                    <i class="fas fa-user-plus mr-3"></i> Create Customer Account
                                </a>
                            </li>
                        <% } %>

                        <% if (allowed.Contains("AdminGuide")) { %>
                            <li>
                                <a class="flex items-center py-3 px-6 hover:bg-gray-700 transition-colors duration-200 <%= currentPath.Contains("adminguide.aspx") ? "bg-blue-600 font-bold" : "" %>" href='<%= ResolveUrl("~/AdminGuide.aspx") %>'>
                                    <i class="fas fa-book-open mr-3"></i> Admin Guide
                                </a>
                            </li>
                        <% } %>
                    <%
                        }
                        else
                        {
                    %>
                        <li class="py-3 px-6 text-red-500 font-semibold">
                            <i class="fas fa-exclamation-triangle mr-2"></i> Session permissions not loaded
                        </li>
                    <%
                        }
                    %>
                </ul>

                <div class="p-4 mt-auto">
                    <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="w-full text-left py-3 px-6 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors">
                        <i class="fas fa-sign-out-alt mr-2"></i> Logout
                    </asp:LinkButton>
                </div>
            </nav>

            <main id="content" class="flex-1 p-8 pt-20 lg:pt-8 min-h-screen">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let burgerMenu = document.getElementById("burgerMenu");
            let sidebar = document.getElementById("sidebar");

            burgerMenu.addEventListener("click", function () {
                sidebar.classList.toggle("open");
            });
        });
    </script>
</body>
</html>