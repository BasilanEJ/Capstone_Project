<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Client.master.cs" Inherits="RRCManagementSystem.Client" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome (for icons) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body class="flex flex-col min-h-screen bg-gray-50 text-gray-800">
    <form id="form1" runat="server" class="flex flex-col flex-grow">

        <!-- NAVBAR -->
        <nav class="bg-blue-700 text-white shadow-md">
            <div class="max-w-7xl mx-auto px-4">
                <div class="flex justify-between items-center h-16">
                    <!-- Logo / Brand -->
                    <a href="Home.aspx" class="flex items-center space-x-2 text-lg font-bold hover:text-blue-200">
                        <i class="fas fa-cogs"></i>
                        <span>RRC Client</span>
                    </a>

                    <!-- Desktop Menu -->
                    <div class="hidden md:flex space-x-6 items-center">
                        <a href="Home.aspx" class="hover:text-blue-200 transition flex items-center">
                            <i class="fas fa-home mr-1"></i> Home
                        </a>

                        <!-- Notifications -->
                        <div class="relative">
                            <button type="button" onclick="toggleDropdown('notifDropdown')"
                                class="relative hover:text-blue-200 transition">
                                <i class="fas fa-bell text-xl"></i>
                                <span id="notifBadge" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs px-1.5 py-0.5 rounded-full hidden">0</span>
                            </button>

                            <!-- Notification dropdown -->
                            <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-72 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden z-50">
                                <div id="notifList" class="max-h-80 overflow-y-auto p-3 text-sm">
                                    <!-- Notifications will be loaded here -->
                                    <p class="text-center text-gray-500">No new notifications</p>
                                </div>
                            </div>
                        </div>

                        <!-- Profile -->
                        <div class="relative">
                            <button type="button" onclick="toggleDropdown('profileDropdown')"
                                class="flex items-center space-x-2 hover:text-blue-200 transition">
                                <i class="fas fa-user-circle text-xl"></i>
                                <asp:Label ID="lblClientName" runat="server" Text="My Profile"></asp:Label>
                                <i class="fas fa-chevron-down text-xs"></i>
                            </button>

                            <!-- Profile Dropdown -->
                            <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-40 bg-white text-gray-800 rounded-lg shadow-lg overflow-hidden z-50">
                                <a href="Profile.aspx" class="block px-4 py-2 hover:bg-gray-100">
                                    <i class="fas fa-user mr-2"></i> My Profile
                                </a>
                                <a href="../Logout.aspx" class="block px-4 py-2 hover:bg-gray-100">
                                    <i class="fas fa-sign-out-alt mr-2"></i> Logout
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile Toggle Button -->
                    <button type="button" class="md:hidden text-2xl" onclick="toggleMobileMenu()">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Slide Over Menu -->
            <div id="mobileMenu" class="fixed inset-0 bg-black/50 z-50 hidden">
                <div class="absolute right-0 top-0 w-64 bg-blue-700 text-white h-full flex flex-col">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-blue-600">
                        <span class="text-lg font-semibold flex items-center gap-2">
                            <i class="fas fa-cogs"></i> RRC Client
                        </span>
                        <button type="button" onclick="toggleMobileMenu()" class="text-2xl hover:text-gray-200">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <nav class="flex-1 p-4 space-y-3">
                        <a href="Home.aspx" class="block px-3 py-2 rounded hover:bg-blue-600">
                            <i class="fas fa-home mr-2"></i> Home
                        </a>
                        <div>
                            <div class="flex items-center justify-between">
                                <span><i class="fas fa-bell mr-2"></i> Notifications</span>
                                <span id="notifBadgeMobile" class="bg-red-500 text-white text-xs px-1.5 py-0.5 rounded-full hidden">0</span>
                            </div>
                            <div id="notifListMobile" class="mt-2 bg-white text-gray-800 rounded p-2 max-h-72 overflow-y-auto text-sm">
                                <!-- Notifications will load here -->
                                <p class="text-center text-gray-500">No new notifications</p>
                            </div>
                        </div>
                        <a href="Profile.aspx" class="block px-3 py-2 rounded hover:bg-blue-600">
                            <i class="fas fa-user mr-2"></i> My Profile
                        </a>
                        <a href="../Logout.aspx" class="block px-3 py-2 rounded hover:bg-blue-600">
                            <i class="fas fa-sign-out-alt mr-2"></i> Logout
                        </a>
                    </nav>
                </div>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <main class="flex-grow max-w-7xl mx-auto w-full px-4 py-6">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

    </form>

    <!-- FOOTER -->
    <footer class="bg-blue-700 text-white text-center py-4 mt-auto">
        <div class="flex flex-wrap justify-center space-x-3 text-sm">
            <a href="Home.aspx" class="hover:underline">Home</a>
            <span>|</span>
            <a href="AboutUs.aspx" class="hover:underline">About Us</a>
            <span>|</span>
            <a href="PrivacyPolicy.aspx" class="hover:underline">Privacy Policy</a>
        </div>
        <div class="mt-2 text-xs">&copy; <%= DateTime.Now.Year %> RRC Management System. All Rights Reserved.</div>
    </footer>

    <!-- Floating Chat Button
    <a href="ChatWithAdmin.aspx"
       class="fixed bottom-5 right-5 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg w-14 h-14 flex items-center justify-center text-2xl z-50"
       aria-label="Open chat">
        <i class="fab fa-facebook-messenger"></i>
    </a>  -->

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-5 right-5 space-y-3 z-50"></div>

    <!-- Tailwind Scripts -->
    <script>
        // Toggle dropdown menus
        function toggleDropdown(id) {
            document.querySelectorAll('[id$="Dropdown"]').forEach(drop => {
                if (drop.id !== id) drop.classList.add('hidden');
            });
            const dropdown = document.getElementById(id);
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function (e) {
            const dropdowns = document.querySelectorAll('[id$="Dropdown"]');
            dropdowns.forEach(drop => {
                if (!drop.contains(e.target) && !drop.previousElementSibling.contains(e.target)) {
                    drop.classList.add('hidden');
                }
            });
        });

        // Mobile Menu
        function toggleMobileMenu() {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        }

        // ===== Notifications =====
        let lastNotifCount = 0;

        function refreshNotifications() {
            fetch('GetNotifications.aspx', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
                .then(response => response.text())
                .then(data => {
                    const [notifCount, notifHtml] = data.split('|||');
                    const count = parseInt(notifCount || '0', 10);

                    // Desktop
                    const list = document.getElementById('notifList');
                    if (list) list.innerHTML = notifHtml || '<p class="text-center text-gray-500">No notifications</p>';

                    // Mobile
                    const listMobile = document.getElementById('notifListMobile');
                    if (listMobile) listMobile.innerHTML = notifHtml || '<p class="text-center text-gray-500">No notifications</p>';

                    // Badges
                    const badge = document.getElementById('notifBadge');
                    const badgeMobile = document.getElementById('notifBadgeMobile');

                    if (badge) {
                        badge.classList.toggle('hidden', count <= 0);
                        badge.textContent = count;
                    }
                    if (badgeMobile) {
                        badgeMobile.classList.toggle('hidden', count <= 0);
                        badgeMobile.textContent = count;
                    }

                    // Toast for new notifications
                    if (count > lastNotifCount) showToast('🔔 You have a new notification!');
                    lastNotifCount = count;
                })
                .catch(error => console.error('Notification error:', error));
        }

        // ===== Toast Notifications =====
        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'bg-gray-800 text-white px-4 py-2 rounded-lg shadow-lg animate-fade-in';
            toast.textContent = message;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'transition-opacity', 'duration-500');
                toast.addEventListener('transitionend', () => toast.remove());
            }, 4000);
        }

        // Poll every 30 seconds
        setInterval(refreshNotifications, 30000);
        window.addEventListener('load', refreshNotifications);
    </script>

    <style>
        /* Toast animation */
        @keyframes fade-in {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fade-in 0.3s ease-out;
        }
    </style>
</body>
</html>
