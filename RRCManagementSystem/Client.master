<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Client.master.cs" Inherits="RRCManagementSystem.Client" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="flex-grow-1 d-flex flex-column">
        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="Home.aspx"><i class="fas fa-cogs"></i> RRC Client</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="Home.aspx"><i class="fas fa-home"></i> Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell"></i>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notifDropdown">
                                <div id="notifList" class="px-3 py-2" style="max-height: 300px; overflow-y: auto;"></div>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>
                                <asp:Label ID="lblClientName" runat="server" Text="My Profile" CssClass="d-inline"></asp:Label>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                <li><a class="dropdown-item" href="Profile.aspx"><i class="fas fa-user"></i> My Profile</a></li>
                                <li><a class="dropdown-item" href="../Logout.aspx"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <main class="container py-4 flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>

    <!-- FOOTER -->
    <footer class="bg-primary text-white text-center py-3 mt-auto">
        &copy; <%= DateTime.Now.Year %> RRC Management System. All Rights Reserved.
    </footer>

    <!-- CHAT BUTTON -->
    <a href="ChatWithAdmin.aspx" class="btn btn-primary rounded-circle position-fixed"
       style="bottom:30px; right:30px; width:60px; height:60px; font-size:24px; text-align:center; line-height:60px;">
        <i class="fab fa-facebook-messenger"></i>
    </a>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let lastNotifCount = 0;

        function refreshNotifications() {
            fetch('GetNotifications.aspx', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
                .then(response => response.text())
                .then(data => {
                    const [notifCount, notifHtml] = data.split('|||');
                    document.getElementById('notifList').innerHTML = notifHtml;
                    const notifBadge = document.getElementById('notifBadge');

                    const count = parseInt(notifCount);
                    notifBadge.style.display = count > 0 ? 'inline-block' : 'none';
                    notifBadge.innerText = count;

                    if (count > lastNotifCount) {
                        showToast('🔔 You have a new notification!');
                    }
                    lastNotifCount = count;
                })
                .catch(error => console.error('Notification error:', error));
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'toast position-fixed bottom-0 end-0 p-3';
            toast.innerHTML = `<div class="toast show bg-dark text-white" role="alert"><div class="toast-body">${message}</div></div>`;
            document.body.appendChild(toast);
            setTimeout(() => document.body.removeChild(toast), 4000);
        }

        function markNotificationsAsRead() {
            fetch('GetNotifications.aspx?action=markread', { method: 'POST' })
                .then(response => {
                    if (response.ok) {
                        document.getElementById('notifBadge').style.display = 'none';
                    }
                })
                .catch(error => console.error('Mark read error:', error));
        }

        setInterval(refreshNotifications, 30000);
        window.onload = refreshNotifications;
    </script>
</body>
</html>
