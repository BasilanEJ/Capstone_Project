<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="RootAdmin.Master.cs" Inherits="RRCManagementSystem.RootAdmin" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Root Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f8f9fa;
            transition: filter 0.3s ease;
        }
        header {
            height: 60px;
            background: #000;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
        }
        #sidebar {
            background: #000;
            color: #fff;
            width: 280px;
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100vh - 60px);
            overflow-y: auto;
            transition: all 0.3s ease;
            z-index: 1050;
        }
        #sidebar.collapsed {
            width: 70px;
        }
        #sidebar .nav-link {
            color: #fff;
            font-size: 16px;
        }
        #sidebar .nav-link:hover {
            background: #1a1a1a;
        }
        .content-wrapper {
            margin-left: 280px;
            padding: 20px;
            transition: margin-left 0.3s ease;
        }
        .collapsed ~ .content-wrapper {
            margin-left: 70px;
        }
        .toggle-btn {
            font-size: 22px;
            cursor: pointer;
        }

        /* MOBILE RESPONSIVE */
        @media (max-width: 768px) {
            #sidebar {
                left: -280px;
                top: 60px;
            }
            #sidebar.active {
                left: 0;
                box-shadow: 2px 0 5px rgba(0,0,0,0.3);
            }
            .content-wrapper {
                margin-left: 0;
            }
            /* Dim content when sidebar is active */
            body.sidebar-open .content-wrapper {
                filter: brightness(0.7);
                pointer-events: none; /* prevent clicks behind sidebar */
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <!-- HEADER -->
        <header>
            <span class="toggle-btn d-md-none" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </span>
            <div class="fw-bold">Root Admin Panel</div>
            <div>
                <asp:Label ID="lblRootAdminName" runat="server" CssClass="me-3"></asp:Label>
            </div>
        </header>

        <!-- SIDEBAR -->
        <aside id="sidebar">
            <ul class="nav flex-column">
                <li class="nav-item border-bottom">
                    <a class='nav-link px-4 py-3 <%= GetActiveClasses("RootDashboard.aspx") %>' href="RootDashboard.aspx">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </li>

                <!-- Manage Users Dropdown -->
                <li class="nav-item border-bottom">
                    <a class="nav-link px-4 py-3 d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#manageUsers" role="button" aria-expanded="false" aria-controls="manageUsers">
                        <span><i class="fas fa-user-shield me-2"></i> Manage Users</span>
                        <i class="fas fa-chevron-down"></i>
                    </a>
                    <div class="collapse" id="manageUsers">
                        <ul class="nav flex-column bg-dark">
                            <li>
                                <a class='nav-link ps-5 py-2 <%= GetActiveClasses("ViewUser.aspx") %>' href="ViewUser.aspx">
                                    <i class="fas fa-list me-2"></i> View Users
                                </a>
                            </li>
                          
                            <li>
                                <a class='nav-link ps-5 py-2 <%= GetActiveClasses("ArchivedSysUser.aspx") %>' href="ArchivedSuperUser.aspx">
    <i class="fas fa-archive me-2"></i> Archived Users
</a>

                            </li>
                        </ul>
                    </div>
                </li>

                <!-- System Settings -->
                <li class="nav-item border-bottom">
                    <a class='nav-link px-4 py-3 <%= GetActiveClasses("SystemSettings.aspx") %>' href="SystemSettings.aspx">
                        <i class="fas fa-cog me-2"></i> System Settings
                    </a>
                </li>

                <li class="nav-item border-bottom px-4 py-2">
                    <asp:Button ID="Button1" runat="server" Text="Logout" CssClass="btn btn-danger btn-sm w-100" OnClick="btnLogout_Click" />
                </li>
            </ul>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="content-wrapper">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            sidebar.classList.toggle("active");

            // Add body class to dim content on mobile
            document.body.classList.toggle("sidebar-open");
        }
    </script>
</body>
</html>
