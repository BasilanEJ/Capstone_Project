<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inquiry.master.cs" Inherits="RRCManagementSystem.Inquiry" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /></title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Optional per-page head additions -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        /* ===== Base / Typography ===== */
        body { font-family: Arial, sans-serif; animation: fadeIn .8s ease-in-out; padding-top:70px; }
        .top-header { font-size:14px; }
        .contact-info i { margin-right:5px; }

        /* ===== Navbar ===== */
        .navbar { padding:15px 0; transition: all .3s ease-in-out; }
        .navbar-brand .logo, .navbar-brand img { height:50px; max-height:60px; transition:max-height .3s ease-in-out; }
        .navbar-nav .nav-link { font-size:16px; font-weight:600; color:#333; }
        .navbar-nav .nav-link:hover { color:#007bff; }
        .navbar-nav .btn-success { font-weight:bold; padding:8px 15px; border-radius:5px; }

        /* Sticky scroll navbar */
        .scroll-navbar { position:fixed; top:0; left:0; width:100%; z-index:1000; box-shadow:0 4px 6px rgba(0,0,0,.1); }
        .show-navbar { top:0; }

        /* ===== Footer ===== */
        .footer { text-align:center; font-size:14px; }

        /* ===== Animations ===== */
        @keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
        @keyframes fadeSlideDown { from{opacity:0; transform:translateY(-10px);} to{opacity:1; transform:none;} }
        header.top-header { animation: fadeSlideDown .8s ease-in-out; }

        /* ===== Responsive tweaks ===== */
        @media (max-width: 992px) {
          .navbar-brand img{ max-height:50px; }
          .navbar-nav{ text-align:center; }
          .navbar-toggler{ transition: transform .3s ease-in-out; }
          .navbar-toggler:hover{ transform: scale(1.1); }
        }
        @media (max-width: 768px) {
          .navbar-brand img{ max-height:45px; }
          .container{ padding:0 15px; }
          .footer p{ font-size:14px; }
        }
        @media (max-width: 576px) {
          .top-header{ font-size:14px; padding:8px 0; }
          .contact-info span{ display:block; margin-bottom:5px; }
          .social-icons a{ font-size:16px; }
        }

        /* ===================== Modern Floating Chat (Glass + Dark Mode) ===================== */
        :root{
          --chat-accent:#0d6efd;
          --chat-bg:#ffffffcc;
          --chat-border:#e9ecef;
          --chat-text:#212529;
          --chat-muted:#6c757d;
          --chat-bot:#f1f5ff;
          --chat-user:#e8f5e9;
          --shadow:0 12px 30px rgba(0,0,0,.15);
        }
        .dark{
          --chat-accent:#66b2ff;
          --chat-bg:#0b1220cc;
          --chat-border:#1f2937;
          --chat-text:#e5e7eb;
          --chat-muted:#9ca3af;
          --chat-bot:#0f1a33;
          --chat-user:#0d2814;
          --shadow:0 12px 30px rgba(0,0,0,.45);
          background-color:#0b1220;
          color:#e5e7eb;
        }

        .rrc-chat{
          position:fixed; right:20px; bottom:20px; z-index:2000; pointer-events:none;
        }
        .rrc-chat *{ box-sizing:border-box; }
        .rrc-chat .chat-toggle{
          pointer-events:auto;
          width:64px; height:64px; border-radius:50%; border:0; cursor:pointer;
          background:var(--chat-accent); color:#fff; font-size:24px; position:relative;
          display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow);
          transition: transform .18s ease, box-shadow .18s ease;
        }
        .rrc-chat .chat-toggle:hover{ transform: translateY(-2px); box-shadow:0 16px 36px rgba(13,110,253,.35); }
        .rrc-chat .pulse{ position:absolute; inset:0; border-radius:50%;
          box-shadow:0 0 0 0 rgba(13,110,253,.45); animation:pulse 2s infinite; }
        @keyframes pulse{ 0%{box-shadow:0 0 0 0 rgba(13,110,253,.45);} 70%{box-shadow:0 0 0 20px rgba(13,110,253,0);} 100%{box-shadow:0 0 0 0 rgba(13,110,253,0);} }

        .rrc-chat .chat-panel{
          pointer-events:auto;
          width:min(480px, 95vw);
          background:var(--chat-bg); backdrop-filter: blur(12px);
          border:1px solid var(--chat-border); border-radius:16px; overflow:hidden;
          box-shadow:var(--shadow);
          position:absolute; right:0; bottom:78px; display:none;
        }
        .rrc-chat.open .chat-panel{ display:flex; flex-direction:column; animation:pop .14s ease; }
        @keyframes pop{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }
        .rrc-chat.open .chat-toggle{ transform: scale(.96); }

        .chat-header{
          display:flex; align-items:center; justify-content:space-between; gap:8px;
          padding:10px 12px; border-bottom:1px solid var(--chat-border);
          background:linear-gradient(180deg, rgba(13,110,253,.12), rgba(13,110,253,0));
        }
        .chat-header .title{ display:flex; align-items:center; gap:10px; color:var(--chat-text); font-weight:700; }
        .chat-header .status{ font-size:12px; color:var(--chat-muted); }
        .chat-header .icon-btn{
          border:0; background:transparent; width:36px; height:36px; border-radius:10px; cursor:pointer; color:var(--chat-text);
        }
        .chat-header .icon-btn:hover{ background:rgba(13,110,253,.08); }

        .chat-body{
          height:480px; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth;
        }
        .msg{
          max-width:86%; padding:10px 12px; border-radius:12px; line-height:1.4; font-size:14px; color:var(--chat-text);
          box-shadow:0 2px 8px rgba(0,0,0,.06);
        }
        .msg.bot{ background:var(--chat-bot); border:1px solid var(--chat-border); border-top-left-radius:4px; }
        .msg.user{ background:var(--chat-user); border-top-right-radius:4px; margin-left:auto; }
        .msg .time{ display:block; margin-top:6px; font-size:11px; color:var(--chat-muted); }
        .fade-in{ animation:fadeIn .16s ease; }
        @keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

        .quick-bar{ display:flex; flex-wrap:wrap; gap:8px; }
        .quick-chip{
          border:1px solid var(--chat-border); background:transparent; color:var(--chat-text);
          padding:6px 10px; border-radius:999px; font-size:12px; cursor:pointer;
        }
        .quick-chip:hover{ border-color:var(--chat-accent); color:var(--chat-accent); }

        .typing{ display:inline-flex; gap:4px; align-items:center; padding:8px 10px; border-radius:12px;
          background:var(--chat-bot); border:1px solid var(--chat-border); }
        .dot{ width:6px; height:6px; border-radius:50%; background:var(--chat-muted); opacity:.6; animation:bounce 1.2s infinite; }
        .dot:nth-child(2){ animation-delay:.15s; } .dot:nth-child(3){ animation-delay:.3s; }
        @keyframes bounce{ 0%,80%,100%{transform:scale(.8);} 40%{transform:scale(1);} }

        .chat-input{
          border-top:1px solid var(--chat-border); padding:10px; display:flex; gap:8px; align-items:flex-end;
          background:linear-gradient(0deg, rgba(13,110,253,.06), rgba(13,110,253,0));

        }
        .chat-input textarea{
          resize:none; width:100%; min-height:42px; max-height:140px;
          border:1px solid var(--chat-border); background:transparent; color:var(--chat-text);
          border-radius:12px; padding:10px 12px; outline:none;
        }
        .chat-input textarea::placeholder{ color:var(--chat-muted); }
        .chat-input .send-btn{
          border:0; background:var(--chat-accent); color:#fff; border-radius:12px; padding:10px 14px;
          display:flex; align-items:center; justify-content:center; height:42px; min-width:46px; cursor:pointer;
        }
        .chat-input .send-btn:disabled{ opacity:.6; cursor:not-allowed; }

        @media (max-width: 576px){
          .rrc-chat{ right:12px; bottom:12px; }
          .rrc-chat .chat-panel{ width:min(420px, 96vw); }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Scroll Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white scroll-navbar" id="scrollNavbar">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand" href="Default.aspx">
                    <img src="/images/rrclogo.jpg" alt="RRC Termite" class="logo" />
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a href="../Login.aspx" class="btn btn-primary ms-3">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- ===================== Floating Modern Chat Assistant ===================== -->
        <div class="rrc-chat" id="rrcChat" aria-live="polite">
            <!-- Toggle button -->
            <button type="button" class="chat-toggle" id="chatToggle" aria-label="Open chat">
                <i class="fa-solid fa-message"></i>
                <span class="pulse" aria-hidden="true"></span>
            </button>

            <!-- Chat panel -->
            <div class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chatTitle">
                <div class="chat-header">
                    <div class="title">
                        <img src="/images/rrclogo.jpg" alt="RRC" style="width:28px;height:28px;border-radius:6px;object-fit:cover;">
                        <div>
                            <div id="chatTitle">RRC Assistant</div>
                            <div class="status">
                                <i class="fa-solid fa-circle" style="font-size:8px;color:#27ae60;"></i>
                                Online
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
                            <i class="fa-solid fa-moon"></i>
                        </button>
                       <button type="button" class="icon-btn" id="closeChat" title="Close" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <div class="chat-body" id="chatBody">
                    <!-- Welcome message -->
                    <div class="msg bot fade-in">
                        Hi! I’m your RRC Assistant. Ask me about bookings, services, warranties, or inspections.
                        <span class="time" data-time></span>
                    </div>
                    <!-- Quick replies -->
                    <div class="quick-bar" id="quickBar">
                        <button type="button" class="quick-chip">What services do you offer?</button>
                        <button type="button" class="quick-chip">How to book?</button>
                        <button type="button" class="quick-chip">Do you have free inspection?</button>
                        <button type="button" class="quick-chip">Signs of termites?</button>
                    </div>
                </div>

                <div class="chat-input">
                    <textarea id="chatInput" rows="1" placeholder=""></textarea>
                    <button type="button" class="send-btn" id="sendBtn" aria-label="Send">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer bg-dark text-white py-4 mt-4">
            <div class="container text-center">
                <p>&copy; <%= DateTime.Now.Year %> RRC Termite &amp; Pest Control. All rights reserved.</p>
                <p>Follow us:
                    <a href="https://www.facebook.com/rrcpestcontrolservice" class="text-white mx-2">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </p>
            </div>
        </footer>

        <!-- Optional per-page scripts -->
        <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />

    </form>

    <!-- Bootstrap Bundle (JS) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ===== Scroll Navbar behavior ===== -->
    <script>
        (function(){
            let lastScrollTop = 0;
            const navbar = document.getElementById("scrollNavbar");
            window.addEventListener("scroll", function(){
                const st = window.pageYOffset || document.documentElement.scrollTop;
                if (st < lastScrollTop) {
                    navbar.classList.add("show-navbar");
                } else {
                    navbar.classList.remove("show-navbar");
                }
                lastScrollTop = st <= 0 ? 0 : st;
            });
        })();
    </script>

    <!-- ===== Modern Chat Assistant Logic ===== -->
    <script>
        (function () {
            const chat = document.getElementById('rrcChat');
            const toggle = document.getElementById('chatToggle');
            const panel = chat.querySelector('.chat-panel');
            const closeBtn = document.getElementById('closeChat');
            const themeToggle = document.getElementById('themeToggle');
            const bodyEl = document.getElementById('chatBody');
            const input = document.getElementById('chatInput');
            const sendBtn = document.getElementById('sendBtn');
            const quickBar = document.getElementById('quickBar');

            // Persisted state
            const savedTheme = localStorage.getItem('rrcTheme');
            if (savedTheme === 'dark') document.body.classList.add('dark');
            const savedOpen = localStorage.getItem('rrcChatOpen');
            if (savedOpen === '1') { chat.classList.add('open'); }

            // Smart answers
            const smartAnswers = [
                { keywords: ["how can i book", "how to book", "make a booking", "set an appointment", "schedule service", "book a service", "how to avail", "avail service", "appointment", "book", "booking", "i want to book", "need to book"], answer: "You can sign up and submit an inquiry using the form on this page. We’ll contact you shortly!" },
                { keywords: ["what services", "what service", "services do you offer", "available services", "treatments", "types of service", "pest control services", "termite treatment", "general pest treatment", "what treatments", "what do you treat", "service list", "services"], answer: "We offer Termite Control, General Pest Control, Soil Poisoning, Reticulation Systems, and more." },
                { keywords: ["contact", "how do i contact", "contact info", "email", "phone number", "call", "reach you", "get in touch", "how to contact"], answer: "Email: rrcpestcontrol28@gmail.com. Smart: +63 947 721 7510 / +63 961 340 3036. Globe: +63 967 047 9074 / +63 967 047 9056." },
                { keywords: ["location", "address", "where are you located", "branch", "office", "area", "where to find you", "head office", "service area"], answer: "We’re based in the Philippines (NCR focus) and also serve Batangas & Pangasinan." },
                { keywords: ["business hours", "schedule", "what time are you open", "office hours", "open", "opening time", "available hours", "operating hours", "when are you open"], answer: "We’re available 24/7." },
                { keywords: ["free inspection", "site visit", "initial check", "check my house", "free check up", "assessment", "do you inspect for free", "inspection fee"], answer: "Yes! FREE ocular inspections within serviceable areas. Send an inquiry and we’ll schedule a visit." },
                { keywords: ["safe for pets", "safe for kids", "children", "pet friendly", "eco friendly", "toxic", "hazardous", "is it safe", "is your service safe"], answer: "Our treatments are pet- and child-safe, using eco-friendly solutions approved by local authorities." },
                { keywords: ["signs of termites", "how to know", "termites", "evidence", "infestation", "check for termites", "do i have termites", "termite problem"], answer: "Watch for hollow wood, mud tubes, droppings, and discarded wings near wooden areas/windows." },
                { keywords: ["baiting system", "how baiting works", "termite bait", "station", "colony elimination", "bait station", "how to eliminate termites"], answer: "Bait stations attract termites to a slow-acting toxic bait they share in the colony, eliminating it." },
                { keywords: ["soil poisoning", "what is soil treatment", "termites from ground", "soil injection", "underground treatment", "treatment for soil"], answer: "We apply termiticide to the soil foundation to prevent termite entry from underground." },
                { keywords: ["reticulation", "reticulation system", "pipe treatment", "how reticulation works", "underfloor piping", "chemical pipe system"], answer: "Pipes installed during construction let us re-apply chemicals later without drilling." },
                { keywords: ["general pest control", "common pests", "household pests", "cockroach", "mosquito", "rat", "mouse", "ant", "bed bug", "insects", "bugs", "pest control"], answer: "General pest control includes cockroaches, mosquitoes, ants, bed bugs, rats, spiders, and more." },
                { keywords: ["commercial pest control", "business", "office", "restaurant", "warehouse", "industrial", "shop", "commercial treatment"], answer: "Yes, we service offices, restaurants/food businesses, warehouses, and industrial sites." },
                { keywords: ["payment", "how to pay", "gcash", "bank", "mode of payment", "accept credit", "payment options", "how can i pay", "cash only"], answer: "We currently accept cash. Bank transfers may be arranged with admin coordination." },
                { keywords: ["how long does it take", "treatment time", "how long", "duration", "service duration", "time needed"], answer: "Most treatments take 3–4 hours depending on severity and area size." },
                { keywords: ["do i need to leave", "stay inside", "evacuate", "leave the house", "safe to stay", "can i stay during treatment"], answer: "Usually you can stay. If temporary evacuation is needed, we’ll let you know before the service." },
                { keywords: ["warranty", "guarantee", "after service", "follow up", "come back if not gone", "return visit"], answer: "Warranties vary from 30 days up to 2 years depending on service. Confirm with the assigned technician/inspector." },
                { keywords: ["certified", "licensed", "legit", "registered", "qualified", "legal company"], answer: "We’re a registered provider with trained and licensed technicians." }
            ];

            function nowTime() {
                const d = new Date();
                return d.toLocaleString('en-PH', { hour: '2-digit', minute: '2-digit' });
            }

            function addMsg(text, who = 'bot') {
                const wrap = document.createElement('div');
                wrap.className = `msg ${who} fade-in`;
                wrap.innerHTML = `${text}<span class="time">${nowTime()}</span>`;
                bodyEl.appendChild(wrap);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return wrap;
            }

            function addTyping() {
                const box = document.createElement('div');
                box.className = 'typing fade-in';
                box.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
                bodyEl.appendChild(box);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return box;
            }

            function findSmartAnswer(userInput) {
                const clean = userInput.toLowerCase().replace(/[^\w\s]/g, '');
                for (const item of smartAnswers) {
                    for (const k of item.keywords) {
                        if (clean.includes(k)) return item.answer;
                    }
                }
                return "Sorry, I don’t have an answer to that. You can send us an inquiry and we’ll get back to you.";
            }

            function send(message) {
                if (!message || !message.trim()) return;
                addMsg(message.trim(), 'user');
                const typing = addTyping();
                setTimeout(() => {
                    typing.remove();
                    const reply = findSmartAnswer(message);
                    addMsg(reply, 'bot');
                }, 550);
            }

            // Quick replies
            if (quickBar) {
                quickBar.addEventListener('click', (e) => {
                    const btn = e.target.closest('.quick-chip');
                    if (!btn) return;
                    send(btn.textContent);
                });
            }

            // Toggle open/close
            toggle.addEventListener('click', () => {
                chat.classList.toggle('open');
                localStorage.setItem('rrcChatOpen', chat.classList.contains('open') ? '1' : '0');
            });
            closeBtn.addEventListener('click', () => {
                chat.classList.remove('open');
                localStorage.setItem('rrcChatOpen', '0');
            });

            // Theme toggle
            themeToggle.addEventListener('click', () => {
                document.body.classList.toggle('dark');
                localStorage.setItem('rrcTheme', document.body.classList.contains('dark') ? 'dark' : 'light');
            });

            // Input behaviors
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    const val = input.value;
                    input.value = '';
                    send(val);
                }
            });
            sendBtn.addEventListener('click', () => { const v = input.value; input.value = ''; send(v); });

            // Set initial welcome time
            const t = document.querySelector('[data-time]');
            if (t) { t.textContent = nowTime(); }
        })();
    </script>
</body>
</html>
