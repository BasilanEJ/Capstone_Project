<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inquiry.master.cs" Inherits="RRCManagementSystem.Inquiry" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /></title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Optional per-page head additions -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        /* ===== Base / Typography ===== */
        body { font-family: Arial, sans-serif; animation: fadeIn .8s ease-in-out; padding-top:70px; }
        .top-header { font-size:14px; }
        .contact-info i { margin-right:5px; }

        /* ===== Navbar ===== */
        .navbar { padding:15px 0; transition: all .3s ease-in-out; }
        .navbar-brand .logo, .navbar-brand img { height:50px; max-height:60px; transition:max-height .3s ease-in-out; }
        .navbar-nav .nav-link { font-size:16px; font-weight:600; color:#333; }
        .navbar-nav .nav-link:hover { color:#007bff; }
        .navbar-nav .btn-success { font-weight:bold; padding:8px 15px; border-radius:5px; }

        /* Sticky scroll navbar */
        .scroll-navbar { position:fixed; top:0; left:0; width:100%; z-index:1000; box-shadow:0 4px 6px rgba(0,0,0,.1); }
        .show-navbar { top:0; }

        /* ===== Footer ===== */
        .footer { text-align:center; font-size:14px; }

        /* ===== Animations ===== */
        @keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
        @keyframes fadeSlideDown { from{opacity:0; transform:translateY(-10px);} to{opacity:1; transform:none;} }
        header.top-header { animation: fadeSlideDown .8s ease-in-out; }

        /* ===== Responsive tweaks ===== */
        @media (max-width: 992px) {
          .navbar-brand img{ max-height:50px; }
          .navbar-nav{ text-align:center; }
          .navbar-toggler{ transition: transform .3s ease-in-out; }
          .navbar-toggler:hover{ transform: scale(1.1); }
        }
        @media (max-width: 768px) {
          .navbar-brand img{ max-height:45px; }
          .container{ padding:0 15px; }
          .footer p{ font-size:14px; }
        }
        @media (max-width: 576px) {
          .top-header{ font-size:14px; padding:8px 0; }
          .contact-info span{ display:block; margin-bottom:5px; }
          .social-icons a{ font-size:16px; }
        }

        /* ===================== Modern Floating Chat (Glass) ===================== */
        :root{
          --chat-accent:#0d6efd;
          --chat-bg:#ffffffcc;
          --chat-border:#e9ecef;
          --chat-text:#212529;
          --chat-muted:#6c757d;
          --chat-bot:#f1f5ff;
          --chat-user:#e8f5e9;
          --shadow:0 12px 30px rgba(0,0,0,.15);
        }

        .rrc-chat{ position:fixed; right:20px; bottom:20px; z-index:2000; pointer-events:none; }
        .rrc-chat *{ box-sizing:border-box; }
        .rrc-chat .chat-toggle{
          pointer-events:auto;
          width:64px; height:64px; border-radius:50%; border:0; cursor:pointer;
          background:var(--chat-accent); color:#fff; font-size:24px; position:relative;
          display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow);
          transition: transform .18s ease, box-shadow .18s ease;
        }
        .rrc-chat .chat-toggle:hover{ transform: translateY(-2px); box-shadow:0 16px 36px rgba(13,110,253,.35); }
        .rrc-chat .pulse{ position:absolute; inset:0; border-radius:50%;
          box-shadow:0 0 0 0 rgba(13,110,253,.45); animation:pulse 2s infinite; }
        @keyframes pulse{ 0%{box-shadow:0 0 0 0 rgba(13,110,253,.45);} 70%{box-shadow:0 0 0 20px rgba(13,110,253,0);} 100%{box-shadow:0 0 0 0 rgba(13,110,253,0);} }

        .rrc-chat .chat-panel{
          pointer-events:auto;
          width:min(480px, 95vw);
          background:var(--chat-bg); backdrop-filter: blur(12px);
          border:1px solid var(--chat-border); border-radius:16px; overflow:hidden;
          box-shadow:var(--shadow);
          position:absolute; right:0; bottom:78px; display:none;
        }
        .rrc-chat.open .chat-panel{ display:flex; flex-direction:column; animation:pop .14s ease; }
        @keyframes pop{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }
        .rrc-chat.open .chat-toggle{ transform: scale(.96); }

        .chat-header{
          display:flex; align-items:center; justify-content:space-between; gap:8px;
          padding:10px 12px; border-bottom:1px solid var(--chat-border);
          background:linear-gradient(180deg, rgba(13,110,253,.12), rgba(13,110,253,0));
        }
        .chat-header .title{ display:flex; align-items:center; gap:10px; color:var(--chat-text); font-weight:700; }
        .chat-header .status{ font-size:12px; color:var(--chat-muted); }
        .chat-header .icon-btn{ border:0; background:transparent; width:36px; height:36px; border-radius:10px; cursor:pointer; color:var(--chat-text); }
        .chat-header .icon-btn:hover{ background:rgba(13,110,253,.08); }

        .chat-body{ height:480px; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth; }
        .msg{ max-width:86%; padding:10px 12px; border-radius:12px; line-height:1.4; font-size:14px; color:var(--chat-text); box-shadow:0 2px 8px rgba(0,0,0,.06); }
        .msg.bot{ background:var(--chat-bot); border:1px solid var(--chat-border); border-top-left-radius:4px; }
        .msg.user{ background:var(--chat-user); border-top-right-radius:4px; margin-left:auto; }
        .msg .time{ display:block; margin-top:6px; font-size:11px; color:var(--chat-muted); }
        .fade-in{ animation:fadeIn .16s ease; }
        @keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

        .quick-bar{ display:flex; flex-wrap:wrap; gap:8px; }
        .quick-chip{ border:1px solid var(--chat-border); background:transparent; color:var(--chat-text); padding:6px 10px; border-radius:999px; font-size:14px; cursor:pointer; }
        .quick-chip:hover{ border-color:var(--chat-accent); color:var(--chat-accent); }

        .typing{ display:inline-flex; gap:4px; align-items:center; padding:8px 10px; border-radius:12px; background:var(--chat-bot); border:1px solid var(--chat-border); }
        .dot{ width:6px; height:6px; border-radius:50%; background:var(--chat-muted); opacity:.6; animation:bounce 1.2s infinite; }
        .dot:nth-child(2){ animation-delay:.15s; } .dot:nth-child(3){ animation-delay:.3s; }
        @keyframes bounce{ 0%,80%,100%{transform:scale(.8);} 40%{transform:scale(1);} }

        .chat-input{ border-top:1px solid var(--chat-border); padding:10px; display:flex; gap:8px; align-items:flex-end; background:linear-gradient(0deg, rgba(13,110,253,.06), rgba(13,110,253,0)); }
        .chat-input .notice { font-size:13px; color:var(--chat-muted); padding:6px 2px; }

        @media (max-width: 576px){ .rrc-chat{ right:12px; bottom:12px; } .rrc-chat .chat-panel{ width:min(420px, 96vw); } }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Scroll Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white scroll-navbar" id="scrollNavbar">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand" href="Default.aspx">
                    <img src="/images/rrclogo.jpg" alt="RRC Termite" class="logo" />
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a href="../Login.aspx" class="btn btn-primary ms-3">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- ===================== Floating Modern Chat Assistant (FAQ-only) ===================== -->
        <div class="rrc-chat" id="rrcChat" aria-live="polite">
            <!-- Toggle button -->
            <button type="button" class="chat-toggle" id="chatToggle" aria-label="Open chat">
                <i class="fa-solid fa-message"></i>
                <span class="pulse" aria-hidden="true"></span>
            </button>

            <!-- Chat panel -->
            <div class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chatTitle">
                <div class="chat-header">
                    <div class="title">
                        <img src="/images/rrclogo.jpg" alt="RRC" style="width:28px;height:28px;border-radius:6px;object-fit:cover;">
                        <div>
                            <div id="chatTitle">RRC Assistant</div>
                            <div class="status">
                                <i class="fa-solid fa-circle" style="font-size:8px;color:#27ae60;"></i>
                                Online
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="icon-btn" id="closeChat" title="Close" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <div class="chat-body" id="chatBody">
                    <!-- Welcome message -->
                    <div class="msg bot fade-in">
                        Hi! I’m your RRC Assistant. Tap a question below to see answers about bookings, services, warranties, or inspections.
                        <span class="time" data-time></span>
                    </div>

                    <!-- Quick replies (FAQ buttons) -->
                    <div class="quick-bar" id="quickBar">
                        <!-- Booking -->
                        <button type="button" class="quick-chip" data-question="How to book?">How to book?</button>
                        <button type="button" class="quick-chip" data-question="Do you have free inspection?">Free inspection?</button>
                        <button type="button" class="quick-chip" data-question="What are your business hours?">Business hours?</button>

                        <!-- Services -->
                        <button type="button" class="quick-chip" data-question="What services do you offer?">Services offered</button>
                        <button type="button" class="quick-chip" data-question="What is soil poisoning?">Soil poisoning</button>
                        <button type="button" class="quick-chip" data-question="How does the reticulation system work?">Reticulation system</button>
                        <button type="button" class="quick-chip" data-question="What is general pest control?">General pest control</button>
                        <button type="button" class="quick-chip" data-question="Do you handle commercial pest control?">Commercial pest control</button>

                        <!-- Safety & Warranty -->
                        <button type="button" class="quick-chip" data-question="Is the treatment safe for kids and pets?">Kid/Pet safety</button>
                        <button type="button" class="quick-chip" data-question="Do you provide a warranty?">Warranty</button>

                        <!-- Termite Info -->
                        <button type="button" class="quick-chip" data-question="What are the signs of termites?">Signs of termites</button>
                        <button type="button" class="quick-chip" data-question="How does termite baiting work?">Baiting system</button>

                        <!-- Coverage & Contact -->
                        <button type="button" class="quick-chip" data-question="What areas do you cover?">Service areas</button>
                        <button type="button" class="quick-chip" data-question="How can I contact you?">Contact info</button>

                        <!-- Payments & Duration -->
                        <button type="button" class="quick-chip" data-question="What payment methods do you accept?">Payment methods</button>
                        <button type="button" class="quick-chip" data-question="How long does a treatment take?">Treatment duration</button>
                        <button type="button" class="quick-chip" data-question="Do I need to leave the house during treatment?">Do I need to leave?</button>
                    </div>
                </div>

             
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer bg-dark text-white py-4 mt-4">
            <div class="container text-center">
                <p>&copy; <%= DateTime.Now.Year %> RRC Termite &amp; Pest Control. All rights reserved.</p>
                <p>Follow us:
                    <a href="https://www.facebook.com/rrcpestcontrolservice" class="text-white mx-2">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </p>
            </div>
        </footer>

        <!-- Optional per-page scripts -->
        <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />

    </form>

    <!-- Bootstrap Bundle (JS) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ===== Scroll Navbar behavior ===== -->
    <script>
        (function(){
            let lastScrollTop = 0;
            const navbar = document.getElementById("scrollNavbar");
            window.addEventListener("scroll", function(){
                const st = window.pageYOffset || document.documentElement.scrollTop;
                if (st < lastScrollTop) {
                    navbar.classList.add("show-navbar");
                } else {
                    navbar.classList.remove("show-navbar");
                }
                lastScrollTop = st <= 0 ? 0 : st;
            });
        })();
    </script>

    <!-- ===== Modern Chat Assistant Logic (FAQ-only, no dark mode) ===== -->
    <script>
        (function () {
            const chat = document.getElementById('rrcChat');
            const toggle = document.getElementById('chatToggle');
            const closeBtn = document.getElementById('closeChat');
            const bodyEl = document.getElementById('chatBody');
            const quickBar = document.getElementById('quickBar');

            // Persisted open/close state only
            const savedOpen = localStorage.getItem('rrcChatOpen');
            if (savedOpen === '1') { chat.classList.add('open'); }

            // ---- ANSWER BANK (FAQ) ----
            const FAQ = [
                { q: "How to book?", a: "You can sign up and submit an inquiry using the form on this page. We’ll contact you shortly to schedule!" },
                { q: "Do you have free inspection?", a: "Yes! FREE ocular inspections within serviceable areas. Send an inquiry and we’ll set a visit." },
                { q: "What are your business hours?", a: "We’re available 24/7." },
                { q: "What services do you offer?", a: "We offer Termite Control, General Pest Control, Soil Poisoning, Reticulation Systems, and more." },
                { q: "What is soil poisoning?", a: "We apply termiticide to the soil foundation to prevent termite entry from underground." },
                { q: "How does the reticulation system work?", a: "Pipes installed during construction let us re-apply chemicals later without drilling." },
                { q: "What is general pest control?", a: "General pest control includes cockroaches, mosquitoes, ants, bed bugs, rats, spiders, and more." },
                { q: "Do you handle commercial pest control?", a: "Yes, we service offices, restaurants/food businesses, warehouses, and industrial sites." },
                { q: "Is the treatment safe for kids and pets?", a: "Our treatments are pet- and child-safe, using eco-friendly solutions approved by local authorities." },
                { q: "Do you provide a warranty?", a: "Warranties range from 30 days up to 2 years depending on the service. Confirm with your technician/inspector." },
                { q: "What are the signs of termites?", a: "Watch for hollow wood, mud tubes, droppings, and discarded wings near wooden areas/windows." },
                { q: "How does termite baiting work?", a: "Bait stations attract termites to a slow-acting toxic bait they share in the colony, eliminating it." },
                { q: "What areas do you cover?", a: "We’re based in the Philippines (NCR focus) and also serve Batangas & Pangasinan." },
                { q: "How can I contact you?", a: "Email: rrcpestcontrol28@gmail.com. Smart: +63 947 721 7510 / +63 961 340 3036. Globe: +63 967 047 9074 / +63 967 047 9056." },
                { q: "What payment methods do you accept?", a: "We currently accept cash. Bank transfers may be arranged with admin coordination." },
                { q: "How long does a treatment take?", a: "Most treatments take 3–4 hours depending on severity and area size." },
                { q: "Do I need to leave the house during treatment?", a: "Usually you can stay. If temporary evacuation is needed, we’ll let you know before the service." }
            ];

            function nowTime() {
                const d = new Date();
                return d.toLocaleString('en-PH', { hour: '2-digit', minute: '2-digit' });
            }

            function addMsg(text, who = 'bot') {
                const wrap = document.createElement('div');
                wrap.className = `msg ${who} fade-in`;
                wrap.innerHTML = `${text}<span class="time">${nowTime()}</span>`;
                bodyEl.appendChild(wrap);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return wrap;
            }

            function addTyping() {
                const box = document.createElement('div');
                box.className = 'typing fade-in';
                box.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
                bodyEl.appendChild(box);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return box;
            }

            function answerFor(question) {
                const qClean = String(question).trim().toLowerCase();
                const hit = FAQ.find(x => x.q.trim().toLowerCase() === qClean);
                return hit ? hit.a : "Sorry, that’s not in our FAQs yet.";
            }

            function sendFAQ(questionText) {
                addMsg(questionText, 'user');
                const typing = addTyping();
                setTimeout(() => {
                    typing.remove();
                    addMsg(answerFor(questionText), 'bot');
                }, 450);
            }

            // Wire quick buttons (no typing)
            if (quickBar) {
                quickBar.addEventListener('click', (e) => {
                    const btn = e.target.closest('.quick-chip');
                    if (!btn) return;
                    const q = btn.getAttribute('data-question') || btn.textContent.trim();
                    sendFAQ(q);
                });
            }

            // Toggle open/close (no page scroll changes)
            toggle.addEventListener('click', () => {
                chat.classList.toggle('open');
                localStorage.setItem('rrcChatOpen', chat.classList.contains('open') ? '1' : '0');
            });
            closeBtn.addEventListener('click', () => {
                chat.classList.remove('open');
                localStorage.setItem('rrcChatOpen', '0');
            });

            // Set initial welcome time if present
            const t = document.querySelector('[data-time]');
            if (t) { t.textContent = nowTime(); }
        })();
    </script>
</body>
</html>