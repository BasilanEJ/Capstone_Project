<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inquiry.master.cs" Inherits="RRCManagementSystem.Inquiry" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />

    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /></title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Optional per-page head additions -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        /* ===== Modern Design Variables ===== */
        :root {
            --primary-color: #0d6efd;
            --primary-hover: #0b5ed7;
            --success-color: #28a745;
            --success-hover: #218838;
            --dark-bg: #1a1a2e;
            --light-bg: #f8f9fa;
            --text-dark: #212529;
            --text-muted: #6c757d;
            --border-color: #e9ecef;
            --shadow-sm: 0 2px 8px rgba(0,0,0,.08);
            --shadow-md: 0 4px 16px rgba(0,0,0,.12);
            --shadow-lg: 0 8px 24px rgba(0,0,0,.15);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ===== Base / Typography ===== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html { 
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            animation: fadeIn .8s ease-in-out;
            padding-top: 80px;
            overflow-x: hidden;
            background: var(--light-bg);
        }

        /* ===== Modern Navbar ===== */
        .navbar { 
            padding: 16px 0;
            transition: var(--transition);
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.95) !important;
            border-bottom: 1px solid rgba(0,0,0,.05);
        }

        .navbar-brand .logo, 
        .navbar-brand img { 
            height: 50px;
            max-height: 60px;
            transition: var(--transition);
            filter: drop-shadow(0 2px 4px rgba(0,0,0,.1));
            background: transparent;
            padding: 0;
            border-radius: 0;
        }

        .navbar-nav .nav-link { 
            font-size: 15px;
            font-weight: 600;
            color: var(--text-dark);
            transition: var(--transition);
            position: relative;
        }

        .navbar-nav .nav-link:hover { 
            color: var(--primary-color);
            transform: translateY(-1px);
        }

        /* Sticky scroll navbar */
        .scroll-navbar { 
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            box-shadow: var(--shadow-md);
        }

        /* ===== Modern Buttons ===== */
        .nav-btn {
            font-weight: 600;
            border-radius: 12px;
            padding: 10px 24px;
            min-width: 120px;
            text-align: center;
            transition: var(--transition);
            border: none;
            box-shadow: var(--shadow-sm);
            position: relative;
            overflow: hidden;
        }

        .nav-btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .nav-btn:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-success.nav-btn {
            background: linear-gradient(135deg, var(--success-color), #20c997);
            animation: pulseGlow 3s infinite;
        }

        .btn-success.nav-btn:hover {
            background: linear-gradient(135deg, var(--success-hover), #1ba87d);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
        }

        .btn-primary.nav-btn {
            background: linear-gradient(135deg, var(--primary-color), #0056b3);
        }

        .btn-primary.nav-btn:hover {
            background: linear-gradient(135deg, var(--primary-hover), #004494);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
        }

        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.4); }
            50% { box-shadow: 0 0 20px 8px rgba(40, 167, 69, 0.2); }
        }

        /* ===== Smart Scroll Button (Up/Down Toggle) ===== */
        .scroll-toggle-btn {
            position: fixed;
            bottom: 110px;
            right: 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 50%;
            width: 56px;
            height: 56px;
            font-size: 20px;
            cursor: pointer;
            box-shadow: var(--shadow-lg);
            display: none;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            z-index: 1999;
        }

        .scroll-toggle-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 8px 28px rgba(102, 126, 234, 0.5);
        }

        .scroll-toggle-btn i {
            transition: transform 0.3s ease;
        }

        /* ===== Modern Chat Assistant ===== */
        .rrc-chat { 
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 2000;
            max-width: calc(100vw - 48px);
        }

        .rrc-chat .chat-toggle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            background: linear-gradient(135deg, var(--primary-color), #0056b3);
            color: #fff;
            font-size: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-lg);
            transition: var(--transition);
            position: relative;
        }

        .rrc-chat .chat-toggle:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 32px rgba(13, 110, 253, 0.4);
        }

        .rrc-chat .pulse {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(13,110,253,.6); }
            70% { box-shadow: 0 0 0 20px rgba(13,110,253,0); }
            100% { box-shadow: 0 0 0 0 rgba(13,110,253,0); }
        }

        .rrc-chat .chat-panel {
            width: min(420px, 92vw);
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0,0,0,.08);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            position: absolute;
            right: 0;
            bottom: 80px;
            display: none;
            flex-direction: column;
        }

        .rrc-chat.open .chat-panel {
            display: flex;
            animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ===== Modern Chat Header ===== */
        .chat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 20px 16px;
            background: linear-gradient(135deg, rgba(13,110,253,.08), rgba(102,126,234,.08));
            border-bottom: 1px solid rgba(0,0,0,.06);
        }

        .chat-header .title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-header .title img {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: var(--shadow-sm);
            background: transparent;
            padding: 0;
        }

        .chat-header .title-text {
            font-weight: 700;
            font-size: 18px;
            color: var(--text-dark);
            line-height: 1.2;
        }

        .chat-header .status {
            font-size: 13px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chat-header .icon-btn {
            border: none;
            background: rgba(0,0,0,.04);
            width: 36px;
            height: 36px;
            border-radius: 12px;
            cursor: pointer;
            color: var(--text-dark);
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chat-header .icon-btn:hover {
            background: rgba(13,110,253,.12);
            transform: scale(1.05);
        }

        /* ===== Modern Chat Body ===== */
        .chat-body {
            height: 440px;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scroll-behavior: smooth;
        }

        .chat-body::-webkit-scrollbar {
            width: 6px;
        }

        .chat-body::-webkit-scrollbar-track {
            background: transparent;
        }

        .chat-body::-webkit-scrollbar-thumb {
            background: rgba(0,0,0,.2);
            border-radius: 10px;
        }

        .msg {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: 14px;
            box-shadow: var(--shadow-sm);
            animation: messageSlide 0.3s ease;
        }

        @keyframes messageSlide {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .msg.bot {
            background: linear-gradient(135deg, #f1f5ff, #e8f2ff);
            border: 1px solid rgba(13,110,253,.15);
            border-top-left-radius: 4px;
            align-self: flex-start;
        }

        .msg.user {
            background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
            border-top-right-radius: 4px;
            align-self: flex-end;
        }

        .msg .time {
            display: block;
            margin-top: 6px;
            font-size: 11px;
            color: var(--text-muted);
            opacity: 0.8;
        }

        .typing {
            display: inline-flex;
            gap: 4px;
            align-items: center;
            padding: 12px 16px;
            border-radius: 16px;
            background: linear-gradient(135deg, #f1f5ff, #e8f2ff);
            border: 1px solid rgba(13,110,253,.15);
            align-self: flex-start;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--primary-color);
            opacity: 0.6;
            animation: bounce 1.4s infinite;
        }

        .dot:nth-child(2) { animation-delay: 0.2s; }
        .dot:nth-child(3) { animation-delay: 0.4s; }

        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
            40% { transform: scale(1.1); opacity: 1; }
        }

        /* ===== Modern FAQ Section ===== */
        .faq-section {
            padding: 16px 20px;
            background: linear-gradient(0deg, rgba(13,110,253,.04), transparent);
            border-top: 1px solid rgba(0,0,0,.06);
        }

        .faq-section label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 8px;
            display: block;
        }

        .faq-section .form-select {
            border-radius: 12px;
            border: 2px solid rgba(0,0,0,.08);
            padding: 10px 14px;
            font-size: 14px;
            transition: var(--transition);
            background-color: white;
            margin-bottom: 10px;
        }

        .faq-section .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(13,110,253,.1);
            outline: none;
        }

        .faq-section .btn {
            width: 100%;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            border: none;
            background: linear-gradient(135deg, var(--primary-color), #0056b3);
            transition: var(--transition);
        }

        .faq-section .btn:hover {
            background: linear-gradient(135deg, var(--primary-hover), #004494);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.3);
        }

        /* ===== Footer ===== */
        .footer {
            background: var(--dark-bg);
            color: white;
            padding: 40px 0;
            margin-top: 60px;
            box-shadow: 0 -4px 12px rgba(0,0,0,.1);
        }

        .footer a {
            transition: var(--transition);
        }

        .footer a:hover {
            color: var(--primary-color) !important;
            transform: translateY(-2px);
        }

        /* ===== Animations ===== */
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* ===== Container ===== */
        .container {
            max-width: 1200px;
        }

        @media (min-width: 1400px) {
            .container { max-width: 1320px; }
        }

        @media (min-width: 1600px) {
            .container { max-width: 1440px; }
        }

        /* ===== Responsive Design ===== */
        @media (max-width: 992px) {
            body { padding-top: 70px; }
            
            .navbar-brand img { max-height: 50px; }
            
            .navbar-nav {
                text-align: center;
                width: 100%;
                padding: 16px 0;
            }
            
            .nav-item {
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                margin: 4px 0;
            }
            
            .nav-btn {
                width: 85%;
                margin: 6px 0;
            }

            .scroll-toggle-btn {
                bottom: 95px;
                right: 20px;
            }
        }

        @media (max-width: 768px) {
            .navbar-brand img { max-height: 45px; }
            
            .scroll-toggle-btn {
                width: 50px;
                height: 50px;
                font-size: 18px;
            }

            .rrc-chat .chat-toggle {
                width: 56px;
                height: 56px;
                font-size: 24px;
            }

            .chat-body {
                height: 380px;
            }
        }

        @media (max-width: 576px) {
            body { padding-top: 65px; }
            
            .nav-btn {
                width: 90%;
                font-size: 14px;
            }

            .scroll-toggle-btn {
                width: 48px;
                height: 48px;
                font-size: 16px;
                bottom: 90px;
                right: 16px;
            }

            .rrc-chat {
                right: 16px;
                bottom: 16px;
            }

            .rrc-chat .chat-toggle {
                width: 52px;
                height: 52px;
                font-size: 22px;
            }

            .rrc-chat .chat-panel {
                width: 95vw;
                bottom: 70px;
            }

            .chat-body {
                height: 360px;
            }
        }

        @media (max-width: 400px) {
            .chat-body { height: 340px; }
        }


        /* ============ Lazy Loading Styles ============ */

/* Image lazy loading placeholder */
img[data-src] {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    min-height: 200px;
}

@keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

/* Fade in effect when image loads */
img.lazy-loaded {
    animation: fadeIn 0.5s ease-in;
}

/* Section lazy loading */
.lazy-section {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.lazy-section.loaded {
    opacity: 1;
    transform: translateY(0);
}

    </style>

 

</head>

<body>
    <form id="form1" runat="server" enctype="multipart/form-data">

        <!-- Scroll Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light scroll-navbar" id="scrollNavbar">
            <div class="container">
                <a class="navbar-brand" href="Default.aspx" aria-label="RRC Home">
                    <img src="/images/logorrc.png" alt="RRC Termite" class="logo" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item d-flex gap-2 flex-wrap justify-content-center">
                            <a href="#ctaSection" class="btn btn-success nav-btn">Register Now!!!</a>

                            <a href="../Login.aspx" class="btn btn-primary nav-btn">Users Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- Smart Scroll Toggle Button (Up/Down) -->
        <button id="scrollToggleBtn" class="scroll-toggle-btn" aria-label="Scroll navigation">
            <i class="fas fa-arrow-down"></i>
        </button>

        <!-- Modern Floating Chat Assistant -->
        <div class="rrc-chat" id="rrcChat" aria-live="polite">
            <button type="button" class="chat-toggle" id="chatToggle" aria-label="Open chat">
                <i class="fa-solid fa-message"></i>
                <span class="pulse" aria-hidden="true"></span>
            </button>

            <div class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chatTitle">
                <div class="chat-header">
                    <div class="title">
                        <img src="/images/rrclogo.jpg" alt="RRC">
                        <div>
                            <div class="title-text" id="chatTitle">RRC Assistant</div>
                            <div class="status">
                                <i class="fa-solid fa-circle" style="font-size:8px;color:#27ae60;"></i>
                                Online
                            </div>
                        </div>
                    </div>
                    <button type="button" class="icon-btn" id="closeChat" title="Close" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="chat-body" id="chatBody">
                    <div class="msg bot">
                        Hi! 👋 I'm your RRC Assistant. Select a question below to get instant answers about our services, bookings, and more.
                        <span class="time" data-time></span>
                    </div>
                </div>

                <div class="faq-section">
                    <label for="faqSelect">Quick Questions</label>
                    <select class="form-select" id="faqSelect" aria-label="Select a frequently asked question">
                        <option value="" selected disabled>Choose a question...</option>
                    </select>
                    <button type="button" class="btn btn-primary" id="askBtn">
                        <i class="fa-solid fa-paper-plane me-2"></i>Ask
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <div class="container text-center">
                <p>&copy; <%= DateTime.Now.Year %> RRC Termite &amp; Pest Control. All rights reserved.</p>
                <p>
                    <a href="AboutUs.aspx" class="text-white mx-2 text-decoration-none">About Us</a> |
                    <a href="https://www.facebook.com/rrcpestcontrolservice" class="text-white mx-2" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </p>
            </div>
        </footer>

        <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<script>
    (function () {
        // Force Bootstrap modal cleanup (works with UpdatePanels)
        function fixModalState() {
            document.body.classList.remove('modal-open');
            document.body.style.overflow = 'auto';
            document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
        }

        // Apply fix when a modal closes
        document.addEventListener('hidden.bs.modal', fixModalState);

        // Also apply fix if Bootstrap somehow fails to trigger events
        document.addEventListener('shown.bs.modal', function (e) {
            // If a modal is opened and another backdrop exists, remove duplicates
            const backdrops = document.querySelectorAll('.modal-backdrop');
            if (backdrops.length > 1) {
                for (let i = 0; i < backdrops.length - 1; i++) {
                    backdrops[i].remove();
                }
            }
            // Lock scroll properly
            document.body.style.overflow = 'hidden';
        });

        // ASP.NET-specific: if postback/UpdatePanel refresh happens, clean up
        if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(fixModalState);
        }

        // Global fail-safe: if body stays frozen for 2s after modal close → unlock
        document.addEventListener('click', function () {
            if (!document.querySelector('.modal.show')) {
                fixModalState();
            }
        });
    })();
</script>



<script>
    // ===== Smart Scroll Toggle Button (Up/Down Navigation) =====
    (function () {
        const scrollBtn = document.getElementById("scrollToggleBtn");
        const icon = scrollBtn.querySelector("i");

        function getDocumentHeight() {
            return Math.max(
                document.body.scrollHeight,
                document.documentElement.scrollHeight
            );
        }

        function getCurrentScroll() {
            return window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
        }

        function updateScrollButton() {
            const scrollTop = getCurrentScroll();
            const windowHeight = window.innerHeight;
            const documentHeight = getDocumentHeight();

            if (scrollTop > 300) {
                scrollBtn.style.display = "flex";
            } else {
                scrollBtn.style.display = "none";
                return;
            }

            const isAtBottom = (scrollTop + windowHeight) >= (documentHeight - 100);

            if (isAtBottom) {
                icon.className = "fas fa-arrow-up";
            } else {
                icon.className = "fas fa-arrow-down";
            }
        }

        scrollBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();

            const scrollTop = getCurrentScroll();
            const windowHeight = window.innerHeight;
            const documentHeight = getDocumentHeight();
            const isAtBottom = (scrollTop + windowHeight) >= (documentHeight - 100);

            if (isAtBottom) {
                if (window.location.hash) {
                    history.pushState("", document.title, window.location.pathname + window.location.search);
                }

                window.scrollTo({
                    top: 0,
                    left: 0,
                    behavior: "smooth"
                });

                setTimeout(() => {
                    document.documentElement.scrollTop = 0;
                    document.body.scrollTop = 0;
                    window.pageYOffset = 0;
                }, 50);

                setTimeout(() => {
                    icon.className = "fas fa-arrow-down";
                }, 500);
            } else {
                const maxScroll = documentHeight - windowHeight;
                window.scrollTo({
                    top: maxScroll,
                    left: 0,
                    behavior: "smooth"
                });
                setTimeout(() => {
                    icon.className = "fas fa-arrow-up";
                }, 500);
            }

            return false;
        });

        let scrollTimeout;
        window.addEventListener("scroll", () => {
            if (scrollTimeout) {
                window.cancelAnimationFrame(scrollTimeout);
            }
            scrollTimeout = window.requestAnimationFrame(updateScrollButton);
        });

        window.addEventListener("resize", updateScrollButton);
        setTimeout(updateScrollButton, 100);
    })();

    // ===== Scroll Navbar Behavior =====
    (function () {
        // Navbar is now always visible, no hide/show behavior
    })();


    // ===== RRC Chat Assistant with Auto-Path Detection =====
    // ===== RRC Chat Assistant with Improved Path Detection =====
    (function () {
        'use strict';

        const chat = document.getElementById('rrcChat');
        const toggle = document.getElementById('chatToggle');
        const closeBtn = document.getElementById('closeChat');
        const bodyEl = document.getElementById('chatBody');
        const select = document.getElementById('faqSelect');
        const askBtn = document.getElementById('askBtn');
        const chatPanel = chat.querySelector('.chat-panel');

        let FAQ = [];

        // Get the base path dynamically
        function getBasePath() {
            const path = window.location.pathname;
            const segments = path.split('/').filter(s => s);

            // Remove the current page
            segments.pop();

            return '/' + segments.join('/');
        }

        // Load FAQs with smart path detection
        function loadFAQs() {
            console.log('🔄 Loading FAQs from server...');
            console.log('Current URL:', window.location.href);
            console.log('Current Path:', window.location.pathname);

            const basePath = getBasePath();
            console.log('Base Path:', basePath);

            // Try multiple path strategies
            const paths = [
                // Absolute paths
                '/GetFAQs.ashx',
                '/Handlers/GetFAQs.ashx',

                // Relative to current location
                'GetFAQs.ashx',
                './GetFAQs.ashx',
                '../GetFAQs.ashx',
                '../../GetFAQs.ashx',

                // Based on common structures
                basePath + '/GetFAQs.ashx',
                basePath + '/../GetFAQs.ashx'
            ];

            // Remove duplicates
            const uniquePaths = [...new Set(paths)];
            console.log('Will try these paths:', uniquePaths);

            tryFetchPaths(uniquePaths);
        }

        async function tryFetchPaths(paths) {
            for (let i = 0; i < paths.length; i++) {
                const path = paths[i];
                try {
                    console.log(`🔍 [${i + 1}/${paths.length}] Trying: ${path}`);

                    const response = await fetch(path, {
                        method: 'GET',
                        cache: 'no-store',
                        headers: {
                            'Accept': 'application/json',
                            'Cache-Control': 'no-cache',
                            'Pragma': 'no-cache'
                        }
                    });

                    console.log(`📡 Response status: ${response.status}`);
                    console.log(`📡 Response type: ${response.headers.get('content-type')}`);

                    if (!response.ok) {
                        console.warn(`⚠️ Path ${path} returned status ${response.status}`);
                        continue;
                    }

                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        console.warn(`⚠️ Path ${path} returned non-JSON content type: ${contentType}`);
                        continue;
                    }

                    const text = await response.text();
                    console.log('📄 Raw response length:', text.length);
                    console.log('📄 Raw response preview:', text.substring(0, 300));

                    // Check if response looks like JSON
                    if (!text.trim().startsWith('[') && !text.trim().startsWith('{')) {
                        console.warn(`⚠️ Response doesn't look like JSON:`, text.substring(0, 100));
                        continue;
                    }

                    const data = JSON.parse(text);
                    console.log('✅ Successfully parsed JSON');
                    console.log('📊 Data type:', Array.isArray(data) ? 'Array' : 'Object');
                    console.log('📊 Data length/keys:', Array.isArray(data) ? data.length : Object.keys(data));

                    if (data && Array.isArray(data) && data.length > 0) {
                        FAQ = data;
                        populateDropdown();
                        console.log(`✅✅✅ SUCCESS! Loaded ${FAQ.length} FAQs from: ${path}`);
                        console.log('📋 FAQ Questions:', FAQ.map(f => f.q));

                        // Store successful path for future use
                        localStorage.setItem('faqPath', path);
                        return true;
                    } else if (data && data.error) {
                        console.error(`❌ Server returned error:`, data.error, data.message);
                    } else {
                        console.warn(`⚠️ Path ${path} returned empty or invalid data:`, data);
                    }
                } catch (error) {
                    console.error(`❌ Error with path ${path}:`, error.message);
                    if (error instanceof SyntaxError) {
                        console.error('❌ JSON Parse Error - response was not valid JSON');
                    }
                }
            }

            console.error('❌❌❌ All paths failed. Using fallback FAQ');
            useFallbackFAQ();
            return false;
        }

        function useFallbackFAQ() {
            console.log('⚠️ Using fallback FAQ');
            FAQ = [
                {
                    q: "How to book?",
                    a: "You can submit an inquiry through our inquiry page. Once submitted, our admin will review and dispatch an inspector to check your property."
                },
                {
                    q: "Need help?",
                    a: "Please contact us at rctermiteandpestcontrol@gmail.com or call us during business hours."
                }
            ];
            populateDropdown();
        }

        function populateDropdown() {
            console.log('🔨 Populating dropdown with', FAQ.length, 'items');

            // Clear existing options except the first one
            while (select.options.length > 1) {
                select.remove(1);
            }

            if (FAQ.length === 0) {
                console.warn('⚠️ No FAQs to populate');
                return;
            }

            const frag = document.createDocumentFragment();

            FAQ.forEach((item, index) => {
                if (!item.q || !item.a) {
                    console.warn(`⚠️ Invalid FAQ item at index ${index}:`, item);
                    return;
                }

                const opt = document.createElement('option');
                opt.value = item.q;
                opt.textContent = item.q;
                frag.appendChild(opt);
                console.log(`➕ Added FAQ ${index + 1}: "${item.q}"`);
            });

            select.appendChild(frag);
            console.log('✅ Dropdown now has', select.options.length - 1, 'FAQ options');
        }

        function nowTime() {
            const d = new Date();
            return d.toLocaleString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
        }

        function addMsg(text, who = 'bot') {
            const wrap = document.createElement('div');
            wrap.className = `msg ${who}`;
            const escapedText = text.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
            wrap.innerHTML = `${escapedText}<span class="time">${nowTime()}</span>`;
            bodyEl.appendChild(wrap);
            bodyEl.scrollTop = bodyEl.scrollHeight;
            return wrap;
        }

        function addTyping() {
            const box = document.createElement('div');
            box.className = 'typing';
            box.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
            bodyEl.appendChild(box);
            bodyEl.scrollTop = bodyEl.scrollHeight;
            return box;
        }

        function answerFor(question) {
            const qClean = String(question).trim().toLowerCase();
            const hit = FAQ.find(x => x.q.trim().toLowerCase() === qClean);

            if (hit) {
                console.log('✅ Found answer for:', question);
                return hit.a;
            } else {
                console.warn('⚠️ No answer found for:', question);
                return "Sorry, I don't have information about that. Please contact us directly for assistance.";
            }
        }

        function sendFAQ(questionText) {
            if (!questionText || questionText.trim() === '') {
                console.warn('⚠️ Empty question submitted');
                return;
            }

            console.log('💬 Sending FAQ:', questionText);
            addMsg(questionText, 'user');

            const typing = addTyping();
            setTimeout(() => {
                typing.remove();
                const answer = answerFor(questionText);
                addMsg(answer, 'bot');
            }, 600);
        }

        function closeChat() {
            chat.classList.remove('open');
            localStorage.setItem('rrcChatOpen', '0');
        }

        function openChat() {
            chat.classList.add('open');
            localStorage.setItem('rrcChatOpen', '1');
        }

        // Event Listeners
        select.addEventListener('change', () => {
            const val = select.value;
            if (val) {
                sendFAQ(val);
                setTimeout(() => {
                    select.value = '';
                }, 100);
            }
        });

        askBtn.addEventListener('click', () => {
            const val = select.value;
            if (!val) {
                select.classList.add('is-invalid');
                setTimeout(() => select.classList.remove('is-invalid'), 1000);
                return;
            }
            sendFAQ(val);
            select.value = '';
        });

        toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            chat.classList.toggle('open');
        });

        closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeChat();
        });

        document.addEventListener('click', (e) => {
            if (chat.classList.contains('open') && !chat.contains(e.target)) {
                closeChat();
            }
        });

        chatPanel.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Initialize
        console.log('🚀 Initializing RRC Chat Assistant...');
        loadFAQs();

        const timeEl = document.querySelector('[data-time]');
        if (timeEl) {
            timeEl.textContent = nowTime();
        }

        const savedOpen = localStorage.getItem('rrcChatOpen');
        if (savedOpen === '1') {
            openChat();
        }

        // Debug helper
        window.debugFAQ = function () {
            console.log('=== FAQ Debug Info ===');
            console.log('Current FAQ array:', FAQ);
            console.log('FAQ count:', FAQ.length);
            console.log('Dropdown options count:', select.options.length - 1);
            console.log('Questions:', FAQ.map(f => f.q));
            return FAQ;
        };

        window.testFAQPath = async function (path) {
            console.log(`Testing path: ${path}`);
            try {
                const response = await fetch(path);
                console.log('Status:', response.status);
                console.log('Content-Type:', response.headers.get('content-type'));
                const text = await response.text();
                console.log('Response:', text);
                return text;
            } catch (error) {
                console.error('Error:', error);
                return null;
            }
        };

        console.log('✅ Chat Assistant initialized');
        console.log('💡 Type debugFAQ() in console to inspect FAQs');
        console.log('💡 Type testFAQPath("/your/path.ashx") to test a specific path');
    })();
</script>

    <script>
        // ============ Modern Lazy Loading System ============

        (function () {
            'use strict';

            // Configuration
            const config = {
                rootMargin: '50px',
                threshold: 0.01
            };


            // Lazy load images
            function lazyLoadImages() {
                const images = document.querySelectorAll('img[data-src]');

                if ('IntersectionObserver' in window) {
                    const imageObserver = new IntersectionObserver(function (entries, observer) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                const src = img.getAttribute('data-src');

                                if (src) {
                                    img.src = src;
                                    img.removeAttribute('data-src');
                                    img.classList.add('lazy-loaded');
                                    imageObserver.unobserve(img);
                                }
                            }
                        });
                    }, config);

                    images.forEach(function (img) {
                        imageObserver.observe(img);
                    });
                } else {
                    // Fallback for older browsers
                    images.forEach(function (img) {
                        const src = img.getAttribute('data-src');
                        if (src) {
                            img.src = src;
                            img.removeAttribute('data-src');
                            img.classList.add('lazy-loaded');
                        }
                    });
                }
            }

            // Lazy load sections
            function lazyLoadSections() {
                const sections = document.querySelectorAll('.lazy-section');

                if ('IntersectionObserver' in window) {
                    const sectionObserver = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('loaded');
                                sectionObserver.unobserve(entry.target);
                            }
                        });
                    }, {
                        rootMargin: '0px',
                        threshold: 0.1
                    });

                    sections.forEach(function (section) {
                        sectionObserver.observe(section);
                    });
                } else {
                    // Fallback
                    sections.forEach(function (section) {
                        section.classList.add('loaded');
                    });
                }
            }

            // Initialize on DOM ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    lazyLoadImages();
                    lazyLoadSections();
                });
            } else {
                lazyLoadImages();
                lazyLoadSections();
            }

            // Re-initialize after UpdatePanel postback
            if (typeof Sys !== 'undefined') {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    lazyLoadImages();
                    lazyLoadSections();
                });
            }
        })();
    </script>

</body>
</html>