<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Inquiry.master.cs" Inherits="RRCManagementSystem.Inquiry" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/Images/rrc-logo.jpg" />

    <title><asp:ContentPlaceHolder ID="PageTitle" runat="server" /></title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">


    <!-- Optional per-page head additions -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <style>
        /* ===== Base / Typography ===== */
        html { scroll-behavior: smooth; }
        body { font-family: Arial, sans-serif; animation: fadeIn .8s ease-in-out; padding-top:70px; }
        .top-header { font-size:14px; }
        .contact-info i { margin-right:5px; }

        /* ===== Navbar ===== */
        .navbar { padding:15px 0; transition: all .3s ease-in-out; }
        .navbar-brand .logo, .navbar-brand img { height:50px; max-height:60px; transition:max-height .3s ease-in-out; }
        .navbar-nav .nav-link { font-size:16px; font-weight:600; color:#333; }
        .navbar-nav .nav-link:hover { color:#007bff; }
        .navbar-nav .btn-primary { font-weight:bold; padding:8px 15px; border-radius:5px; }

        /* Sticky scroll navbar */
        .scroll-navbar { position:fixed; top:0; left:0; width:100%; z-index:1000; box-shadow:0 4px 6px rgba(0,0,0,.1); background:#fff; }
        .show-navbar { top:0; }

        /* ===== Footer ===== */
        .footer { text-align:center; font-size:14px; }

        /* ===== Animations ===== */
        @keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
        @keyframes fadeSlideDown { from{opacity:0; transform:translateY(-10px);} to{opacity:1; transform:none;} }
        header.top-header { animation: fadeSlideDown .8s ease-in-out; }

        /* ===== Layout container responsiveness ===== */
        /* Make the content beautifully wide on desktops and big screens, but comfortable on mobiles */
        .container { max-width: 1200px; }
        @media (min-width: 1400px) { .container { max-width: 1320px; } }
        @media (min-width: 1600px) { .container { max-width: 1440px; } }

        /* ===== Responsive tweaks ===== */
        @media (max-width: 992px) {
          .navbar-brand img{ max-height:50px; }
          .navbar-nav{ text-align:center; }
          .navbar-toggler{ transition: transform .3s ease-in-out; }
          .navbar-toggler:hover{ transform: scale(1.1); }
        }
        @media (max-width: 768px) {
          .navbar-brand img{ max-height:45px; }
          .container{ padding:0 15px; }
          .footer p{ font-size:14px; }
        }
        @media (max-width: 576px) {
          .top-header{ font-size:14px; padding:8px 0; }
          .contact-info span{ display:block; margin-bottom:5px; }
          .social-icons a{ font-size:16px; }
        }

        /* ===================== Modern Floating Chat (Glass) ===================== */
        :root{
          --chat-accent:#0d6efd;
          --chat-bg:#ffffffcc;
          --chat-border:#e9ecef;
          --chat-text:#212529;
          --chat-muted:#6c757d;
          --chat-bot:#f1f5ff;
          --chat-user:#e8f5e9;
          --shadow:0 12px 30px rgba(0,0,0,.15);
        }

        .rrc-chat{ position:fixed; right:20px; bottom:20px; z-index:2000; pointer-events:none; }
        .rrc-chat *{ box-sizing:border-box; }
        .rrc-chat .chat-toggle{
          pointer-events:auto;
          width:64px; height:64px; border-radius:50%; border:0; cursor:pointer;
          background:var(--chat-accent); color:#fff; font-size:24px; position:relative;
          display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow);
          transition: transform .18s ease, box-shadow .18s ease;
        }
        .rrc-chat .chat-toggle:hover{ transform: translateY(-2px); box-shadow:0 16px 36px rgba(13,110,253,.35); }
        .rrc-chat .pulse{ position:absolute; inset:0; border-radius:50%;
          box-shadow:0 0 0 0 rgba(13,110,253,.45); animation:pulse 2s infinite; }
        @keyframes pulse{ 0%{box-shadow:0 0 0 0 rgba(13,110,253,.45);} 70%{box-shadow:0 0 0 20px rgba(13,110,253,0);} 100%{box-shadow:0 0 0 0 rgba(13,110,253,0);} }

        .rrc-chat .chat-panel{
          pointer-events:auto;
          width:min(480px, 95vw);
          background:var(--chat-bg); backdrop-filter: blur(12px);
          border:1px solid var(--chat-border); border-radius:16px; overflow:hidden;
          box-shadow:var(--shadow);
          position:absolute; right:0; bottom:78px; display:none;
        }
        .rrc-chat.open .chat-panel{ display:flex; flex-direction:column; animation:pop .14s ease; }
        @keyframes pop{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }
        .rrc-chat.open .chat-toggle{ transform: scale(.96); }

        .chat-header{
          display:flex; align-items:center; justify-content:space-between; gap:8px;
          padding:10px 12px; border-bottom:1px solid var(--chat-border);
          background:linear-gradient(180deg, rgba(13,110,253,.12), rgba(13,110,253,0));
        }
        .chat-header .title{ display:flex; align-items:center; gap:10px; color:var(--chat-text); font-weight:700; }
        .chat-header .status{ font-size:12px; color:var(--chat-muted); }
        .chat-header .icon-btn{ border:0; background:transparent; width:36px; height:36px; border-radius:10px; cursor:pointer; color:var(--chat-text); }
        .chat-header .icon-btn:hover{ background:rgba(13,110,253,.08); }

        .chat-body{ height:480px; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth; }
        .msg{ max-width:86%; padding:10px 12px; border-radius:12px; line-height:1.4; font-size:14px; color:var(--chat-text); box-shadow:0 2px 8px rgba(0,0,0,.06); }
        .msg.bot{ background:var(--chat-bot); border:1px solid var(--chat-border); border-top-left-radius:4px; }
        .msg.user{ background:var(--chat-user); border-top-right-radius:4px; margin-left:auto; }
        .msg .time{ display:block; margin-top:6px; font-size:11px; color:var(--chat-muted); }
        .fade-in{ animation:fadeIn .16s ease; }
        @keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

        /* Dropdown row */
        .faq-row { display:flex; gap:8px; align-items:center; padding:8px; border-top:1px solid var(--chat-border); background:linear-gradient(0deg, rgba(13,110,253,.06), rgba(13,110,253,0)); }
        .faq-row .form-select{ flex:1; }
        .faq-row .btn{ white-space:nowrap; }

        .typing{ display:inline-flex; gap:4px; align-items:center; padding:8px 10px; border-radius:12px; background:var(--chat-bot); border:1px solid var(--chat-border); }
        .dot{ width:6px; height:6px; border-radius:50%; background:var(--chat-muted); opacity:.6; animation:bounce 1.2s infinite; }
        .dot:nth-child(2){ animation-delay:.15s; } .dot:nth-child(3){ animation-delay:.3s; }
        @keyframes bounce{ 0%,80%,100%{transform:scale(.8);} 40%{transform:scale(1);} }

        /* Chat safe-zone on very small screens */
        @media (max-width: 400px){
          .rrc-chat .chat-panel { width: 95vw; }
          .chat-body { height: 420px; }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Scroll Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white scroll-navbar" id="scrollNavbar">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand" href="Default.aspx" aria-label="RRC Home">
                    <img src="/images/rrclogo.jpg" alt="RRC Termite" class="logo" />
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a href="../Login.aspx" class="btn btn-primary ms-3">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- ===================== Floating Modern Chat Assistant (FAQ-only via Dropdown) ===================== -->
        <div class="rrc-chat" id="rrcChat" aria-live="polite">
            <!-- Toggle button -->
            <button type="button" class="chat-toggle" id="chatToggle" aria-label="Open chat">
                <i class="fa-solid fa-message"></i>
                <span class="pulse" aria-hidden="true"></span>
            </button>

            <!-- Chat panel -->
            <div class="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chatTitle">
                <div class="chat-header">
                    <div class="title">
                        <img src="/images/rrclogo.jpg" alt="RRC" style="width:28px;height:28px;border-radius:6px;object-fit:cover;">
                        <div>
                            <div id="chatTitle">RRC Assistant</div>
                            <div class="status">
                                <i class="fa-solid fa-circle" style="font-size:8px;color:#27ae60;"></i>
                                Online
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="icon-btn" id="closeChat" title="Close" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <div class="chat-body" id="chatBody">
                    <!-- Welcome message -->
                    <div class="msg bot fade-in">
                        Hi! I’m your RRC Assistant. Select a question from the dropdown below to see quick answers about bookings, services, or inspections.
                        <span class="time" data-time></span>
                    </div>
                </div>

                <!-- FAQ dropdown + Ask button -->
                <div class="faq-row">
                    <select class="form-select" id="faqSelect" aria-label="Select a frequently asked question">
                        <option value="" selected disabled>Choose a question…</option>
                        <!-- options will be injected by JS from FAQ array -->
                    </select>
                    <button type="button" class="btn btn-primary" id="askBtn">
                        Ask
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer bg-dark text-white py-4 mt-4">
            <div class="container text-center">
                <p>&copy; <%= DateTime.Now.Year %> RRC Termite &amp; Pest Control. All rights reserved.</p>
                <p>Follow us:
                    <a href="https://www.facebook.com/rrcpestcontrolservice" class="text-white mx-2" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </p>
            </div>
        </footer>

        <!-- Optional per-page scripts -->
        <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />

    </form>

    <!-- Bootstrap Bundle (JS) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ===== Scroll Navbar behavior ===== -->
    <script>
        (function(){
            let lastScrollTop = 0;
            const navbar = document.getElementById("scrollNavbar");
            window.addEventListener("scroll", function(){
                const st = window.pageYOffset || document.documentElement.scrollTop;
                if (st < lastScrollTop) {
                    navbar.classList.add("show-navbar");
                } else {
                    navbar.classList.remove("show-navbar");
                }
                lastScrollTop = st <= 0 ? 0 : st;
            });
        })();
    </script>

    <!-- ===== Modern Chat Assistant Logic (Dropdown FAQ) ===== -->
    <script>
        (function () {
            const chat = document.getElementById('rrcChat');
            const toggle = document.getElementById('chatToggle');
            const closeBtn = document.getElementById('closeChat');
            const bodyEl = document.getElementById('chatBody');
            const select = document.getElementById('faqSelect');
            const askBtn = document.getElementById('askBtn');

            // Persisted open/close state only
            const savedOpen = localStorage.getItem('rrcChatOpen');
            if (savedOpen === '1') { chat.classList.add('open'); }

            // ---- ANSWER BANK (Your reduced FAQ list) ----
            const FAQ = [
                {
                    q: "How to book?",
                    a: "You can submit an inquiry through our inquiry page. Once submitted, our admin will review and dispatch an inspector to check your property."
                },
                {
                    q: "Do you have free inspection?",
                    a: "Our ocular inspections are FREE within serviceable areas. Send an inquiry here and set the date/time you’re available."
                },
                {
                    q: "What are your business hours?",
                    a: "We’re open 24/7. You can submit inquiries and bookings anytime."
                },
                {
                    q: "What services do you offer?",
                    a: "Two service types: Contractual (Baiting System—Above/ In-Ground for colony elimination, Termite Prevention, Soil Poisoning—Pre/Post Construction, Reticulation—Perforated Pipe, Mound Demolition—Queen Finder) and One-Time (General Pest Control for cockroaches, ants, mosquitoes, flies, tick & fleas, bedbugs, rats/rodents)."
                },
                {
                    q: "What areas do you cover?",
                    a: "We mainly cover NCR and can also reach Pangasinan and Batangas (north and south areas)."
                },
                {
                    q: "How can I contact you?",
                    a: "Email: rrctermiteandpestcontrol@gmail.com. Smart: +63 947 721 7510 / +63 961 340 3036. Globe: +63 967 047 9074 / +63 967 047 9056."
                },
                {
                    q: "What payment methods do you accept?",
                    a: "We accept PayPal and PayMongo, plus cash on-hand, online transactions, and bank transfers (arranged with admin)."
                }
            ];

            // Populate dropdown from FAQ list
            function populateDropdown() {
                const frag = document.createDocumentFragment();
                FAQ.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.q;
                    opt.textContent = item.q;
                    frag.appendChild(opt);
                });
                select.appendChild(frag);
            }

            function nowTime() {
                const d = new Date();
                return d.toLocaleString('en-PH', { hour: '2-digit', minute: '2-digit' });
            }

            function addMsg(text, who = 'bot') {
                const wrap = document.createElement('div');
                wrap.className = `msg ${who} fade-in`;
                wrap.innerHTML = `${text}<span class="time">${nowTime()}</span>`;
                bodyEl.appendChild(wrap);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return wrap;
            }

            function addTyping() {
                const box = document.createElement('div');
                box.className = 'typing fade-in';
                box.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
                bodyEl.appendChild(box);
                bodyEl.scrollTop = bodyEl.scrollHeight;
                return box;
            }

            function answerFor(question) {
                const qClean = String(question).trim().toLowerCase();
                const hit = FAQ.find(x => x.q.trim().toLowerCase() === qClean);
                return hit ? hit.a : "Sorry, that’s not in our FAQs yet.";
            }

            function sendFAQ(questionText) {
                addMsg(questionText, 'user');
                const typing = addTyping();
                setTimeout(() => {
                    typing.remove();
                    addMsg(answerFor(questionText), 'bot');
                }, 450);
            }

            // Ask button handler
            askBtn.addEventListener('click', () => {
                const val = select.value;
                if (!val) {
                    // simple nudge
                    select.classList.add('is-invalid');
                    setTimeout(() => select.classList.remove('is-invalid'), 1000);
                    return;
                }
                sendFAQ(val);
            });

            // Toggle open/close (no page scroll changes)
            toggle.addEventListener('click', () => {
                chat.classList.toggle('open');
                localStorage.setItem('rrcChatOpen', chat.classList.contains('open') ? '1' : '0');
            });
            closeBtn.addEventListener('click', () => {
                chat.classList.remove('open');
                localStorage.setItem('rrcChatOpen', '0');
            });

            // Initializations
            populateDropdown();
            const t = document.querySelector('[data-time]');
            if (t) { t.textContent = nowTime(); }
        })();
    </script>
</body>
</html>
